rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================
    // Phase 3: Hardened Global Primitives
    // =========================================================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isVerifiedUser() && request.auth.uid == uid;
    }

    // Zero-read bootstrapped admin check (safe for list queries)
    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'sahidin30@gmail.com';
    }

    // Trusted DB + Bootstrapped Admin check (for single-doc get/create/update/delete)
    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // =========================================================
    // Phase 4: Validation Blueprints (Anti-Update-Gap)
    // =========================================================
    function isValidAdminRecord(data, adminUid) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'role', 'createdAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.uid == adminUid &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
        data.role is string && data.role.size() >= 5 && data.role.size() <= 32 &&
        (data.role == 'Admin Super' || data.role == 'Admin SIM') &&
        data.createdAt is timestamp;
    }

    function isValidStudentDoc(data, studentId) {
      return data.keys().hasAll([
          'id', 'nis', 'nama', 'gender', 'kelas', 'kamar',
          'waliKelas', 'musyrif', 'kelompokQuran', 'pengampuQuran',
          'authorId', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'nis', 'nama', 'gender', 'kelas', 'kamar',
          'waliKelas', 'musyrif', 'kelompokQuran', 'pengampuQuran',
          'authorId', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) && data.id == studentId &&
        data.nis is string && data.nis.size() >= 1 && data.nis.size() <= 40 &&
        data.nama is string && data.nama.size() >= 1 && data.nama.size() <= 120 &&
        data.gender is string && data.gender.size() >= 5 && data.gender.size() <= 16 &&
        (data.gender == 'Putra' || data.gender == 'Putri') &&
        data.kelas is string && data.kelas.size() >= 1 && data.kelas.size() <= 80 &&
        data.kamar is string && data.kamar.size() >= 1 && data.kamar.size() <= 80 &&
        data.waliKelas is string && data.waliKelas.size() <= 120 &&
        data.musyrif is string && data.musyrif.size() <= 120 &&
        data.kelompokQuran is string && data.kelompokQuran.size() <= 120 &&
        data.pengampuQuran is string && data.pengampuQuran.size() <= 120 &&
        isValidId(data.authorId) && data.authorId == request.auth.uid &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStaffPublicDoc(data, staffId) {
      return data.keys().hasAll([
          'id', 'username', 'nama', 'jabatan', 'peran', 'peranTambahan',
          'genderScope', 'waliKelasOf', 'kamarBinaan', 'authorId', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'username', 'nama', 'jabatan', 'peran', 'peranTambahan',
          'genderScope', 'waliKelasOf', 'kamarBinaan', 'authorId', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) && data.id == staffId &&
        data.username is string && data.username.size() >= 1 && data.username.size() <= 100 &&
        data.nama is string && data.nama.size() >= 1 && data.nama.size() <= 120 &&
        data.jabatan is string && data.jabatan.size() >= 1 && data.jabatan.size() <= 120 &&
        data.peran is string && data.peran.size() >= 4 && data.peran.size() <= 32 &&
        (
          data.peran == 'Guru' ||
          data.peran == 'Wali Kelas' ||
          data.peran == 'Musyrif' ||
          data.peran == 'Musyrifah' ||
          data.peran == 'Admin SIM' ||
          data.peran == 'Admin Super'
        ) &&
        data.peranTambahan is list && data.peranTambahan.size() <= 6 &&
        (data.peranTambahan.size() == 0 || (data.peranTambahan[0] is string && data.peranTambahan[0].size() <= 32)) &&
        data.genderScope is string && data.genderScope.size() >= 5 && data.genderScope.size() <= 16 &&
        (data.genderScope == 'Putra' || data.genderScope == 'Putri' || data.genderScope == 'Semua') &&
        data.waliKelasOf is string && data.waliKelasOf.size() <= 80 &&
        data.kamarBinaan is list && data.kamarBinaan.size() <= 10 &&
        (data.kamarBinaan.size() == 0 || (data.kamarBinaan[0] is string && data.kamarBinaan[0].size() <= 80)) &&
        isValidId(data.authorId) && data.authorId == request.auth.uid &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStaffPrivateDoc(data, staffId) {
      return data.keys().hasAll(['staffId', 'whatsapp', 'ownerId', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['staffId', 'whatsapp', 'ownerId', 'createdAt', 'updatedAt']) &&
        isValidId(data.staffId) && data.staffId == staffId &&
        data.whatsapp is string && data.whatsapp.size() <= 40 &&
        isValidId(data.ownerId) && data.ownerId == request.auth.uid &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidScheduleDoc(data, scheduleId) {
      return data.keys().hasAll([
          'id', 'guru', 'hari', 'kelas', 'mapel', 'jamKe',
          'gender', 'kategori', 'authorId', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'guru', 'hari', 'kelas', 'mapel', 'jamKe',
          'gender', 'kategori', 'authorId', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) && data.id == scheduleId &&
        data.guru is string && data.guru.size() >= 1 && data.guru.size() <= 120 &&
        data.hari is string && data.hari.size() >= 4 && data.hari.size() <= 24 &&
        data.kelas is string && data.kelas.size() >= 1 && data.kelas.size() <= 80 &&
        data.mapel is string && data.mapel.size() >= 1 && data.mapel.size() <= 120 &&
        data.jamKe is string && data.jamKe.size() >= 1 && data.jamKe.size() <= 32 &&
        data.gender is string && data.gender.size() >= 5 && data.gender.size() <= 16 &&
        (data.gender == 'Putra' || data.gender == 'Putri') &&
        data.kategori is string && data.kategori.size() >= 8 && data.kategori.size() <= 24 &&
        (data.kategori == 'Akademik' || data.kategori == 'Al-Quran') &&
        isValidId(data.authorId) && data.authorId == request.auth.uid &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAttendanceDoc(data, logId) {
      return data.keys().hasAll([
          'id', 'tanggal', 'tipe', 'gender', 'kelas', 'kamar',
          'studentId', 'studentName', 'status', 'catatan', 'petugas',
          'authorId', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'tanggal', 'tipe', 'gender', 'kelas', 'kamar',
          'studentId', 'studentName', 'status', 'catatan', 'petugas',
          'authorId', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) && data.id == logId &&
        data.tanggal is string && data.tanggal.size() >= 10 && data.tanggal.size() <= 20 &&
        data.tipe is string && data.tipe.size() >= 3 && data.tipe.size() <= 40 &&
        data.gender is string && data.gender.size() >= 5 && data.gender.size() <= 16 &&
        (data.gender == 'Putra' || data.gender == 'Putri') &&
        data.kelas is string && data.kelas.size() >= 1 && data.kelas.size() <= 80 &&
        data.kamar is string && data.kamar.size() <= 80 &&
        isValidId(data.studentId) &&
        data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 120 &&
        data.status is string && data.status.size() >= 1 && data.status.size() <= 8 &&
        (data.status == 'H' || data.status == 'S' || data.status == 'I' || data.status == 'A' || data.status == 'T') &&
        data.catatan is string && data.catatan.size() <= 250 &&
        data.petugas is string && data.petugas.size() >= 1 && data.petugas.size() <= 120 &&
        isValidId(data.authorId) && data.authorId == request.auth.uid &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPembinaanDoc(data, recordId) {
      return data.keys().hasAll([
          'id', 'tanggal', 'gender', 'kelas', 'kamar', 'waliKelas',
          'studentId', 'studentName', 'kategori', 'uraian', 'tindakLanjut',
          'statusTindakLanjut', 'poin', 'authorId', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'tanggal', 'gender', 'kelas', 'kamar', 'waliKelas',
          'studentId', 'studentName', 'kategori', 'uraian', 'tindakLanjut',
          'statusTindakLanjut', 'poin', 'authorId', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) && data.id == recordId &&
        data.tanggal is string && data.tanggal.size() >= 10 && data.tanggal.size() <= 20 &&
        data.gender is string && data.gender.size() >= 5 && data.gender.size() <= 16 &&
        (data.gender == 'Putra' || data.gender == 'Putri') &&
        data.kelas is string && data.kelas.size() >= 1 && data.kelas.size() <= 80 &&
        data.kamar is string && data.kamar.size() <= 80 &&
        data.waliKelas is string && data.waliKelas.size() >= 1 && data.waliKelas.size() <= 120 &&
        isValidId(data.studentId) &&
        data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 120 &&
        data.kategori is string && data.kategori.size() >= 3 && data.kategori.size() <= 60 &&
        data.uraian is string && data.uraian.size() >= 1 && data.uraian.size() <= 500 &&
        data.tindakLanjut is string && data.tindakLanjut.size() >= 1 && data.tindakLanjut.size() <= 500 &&
        data.statusTindakLanjut is string && data.statusTindakLanjut.size() >= 6 && data.statusTindakLanjut.size() <= 24 &&
        (
          data.statusTindakLanjut == 'Selesai' ||
          data.statusTindakLanjut == 'Proses' ||
          data.statusTindakLanjut == 'Eskalasi'
        ) &&
        data.poin is number && data.poin >= -1000 && data.poin <= 1000 &&
        isValidId(data.authorId) && data.authorId == request.auth.uid &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // =========================================================
    // Collection Match Blocks
    // =========================================================

    // 1. /admins/{adminUid}
    match /admins/{adminUid} {
      allow get: if isVerifiedUser() && isValidId(adminUid) && (isOwner(adminUid) || isAdmin());
      allow list: if false;
      allow create: if isVerifiedUser() && isValidId(adminUid) &&
        isValidAdminRecord(incoming(), adminUid) &&
        incoming().createdAt == request.time &&
        isBootstrappedAdmin();
      allow update: if isVerifiedUser() && isValidId(adminUid) &&
        isValidAdminRecord(incoming(), adminUid) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        isBootstrappedAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'role']);
      allow delete: if isVerifiedUser() && isValidId(adminUid) && isBootstrappedAdmin();
    }

    // 2. /students/{studentId}
    match /students/{studentId} {
      allow get: if isVerifiedUser() && isValidId(studentId) && (existing().authorId == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.authorId == request.auth.uid || isBootstrappedAdmin());
      allow create: if isVerifiedUser() && isValidId(studentId) &&
        isValidStudentDoc(incoming(), studentId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isVerifiedUser() && isValidId(studentId) &&
        isValidStudentDoc(incoming(), studentId) &&
        incoming().id == existing().id &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            existing().authorId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'kelas', 'kamar', 'waliKelas', 'musyrif', 'kelompokQuran', 'pengampuQuran', 'updatedAt'
            ])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(studentId) && isAdmin();
    }

    // 3. /staff_profiles/{staffId}
    match /staff_profiles/{staffId} {
      allow get: if isVerifiedUser() && isValidId(staffId) && (existing().authorId == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.authorId == request.auth.uid || isBootstrappedAdmin());
      allow create: if isVerifiedUser() && isValidId(staffId) &&
        isValidStaffPublicDoc(incoming(), staffId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (incoming().peran != 'Admin Super' || isBootstrappedAdmin()) &&
        (incoming().peran != 'Admin SIM' || isAdmin());
      allow update: if isVerifiedUser() && isValidId(staffId) &&
        isValidStaffPublicDoc(incoming(), staffId) &&
        incoming().id == existing().id &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            existing().authorId == request.auth.uid &&
            incoming().peran == existing().peran &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'nama', 'jabatan', 'peranTambahan', 'genderScope', 'waliKelasOf', 'kamarBinaan', 'updatedAt'
            ])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(staffId) && isAdmin();

      // 4. Sub-collection: /staff_profiles/{staffId}/private/{privateId} (PII Isolation + Master Gate)
      match /private/{privateId} {
        allow get: if isVerifiedUser() && isValidId(staffId) && isValidId(privateId) &&
          (isOwner(existing().ownerId) || isAdmin()) &&
          exists(/databases/$(database)/documents/staff_profiles/$(staffId)) &&
          (
            get(/databases/$(database)/documents/staff_profiles/$(staffId)).data.authorId == request.auth.uid ||
            isAdmin()
          );
        allow list: if false;
        allow create: if isVerifiedUser() && isValidId(staffId) && isValidId(privateId) &&
          isValidStaffPrivateDoc(incoming(), staffId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/staff_profiles/$(staffId)) &&
          (
            get(/databases/$(database)/documents/staff_profiles/$(staffId)).data.authorId == request.auth.uid ||
            isAdmin()
          );
        allow update: if isVerifiedUser() && isValidId(staffId) && isValidId(privateId) &&
          isValidStaffPrivateDoc(incoming(), staffId) &&
          incoming().staffId == existing().staffId &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/staff_profiles/$(staffId)) && (
            isAdmin() ||
            (
              isOwner(existing().ownerId) &&
              get(/databases/$(database)/documents/staff_profiles/$(staffId)).data.authorId == request.auth.uid &&
              incoming().diff(existing()).affectedKeys().hasOnly(['whatsapp', 'updatedAt'])
            )
          );
        allow delete: if isVerifiedUser() && isValidId(staffId) && isValidId(privateId) && isAdmin();
      }
    }

    // 5. /schedules/{scheduleId}
    match /schedules/{scheduleId} {
      allow get: if isVerifiedUser() && isValidId(scheduleId) && (existing().authorId == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.authorId == request.auth.uid || isBootstrappedAdmin());
      allow create: if isVerifiedUser() && isValidId(scheduleId) &&
        isValidScheduleDoc(incoming(), scheduleId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(scheduleId) &&
        isValidScheduleDoc(incoming(), scheduleId) &&
        incoming().id == existing().id &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            existing().authorId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'guru', 'hari', 'kelas', 'mapel', 'jamKe', 'gender', 'kategori', 'updatedAt'
            ])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(scheduleId) && (existing().authorId == request.auth.uid || isAdmin());
    }

    // 6. /attendance_logs/{logId}
    match /attendance_logs/{logId} {
      allow get: if isVerifiedUser() && isValidId(logId) && (existing().authorId == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.authorId == request.auth.uid || isBootstrappedAdmin());
      allow create: if isVerifiedUser() && isValidId(logId) &&
        isValidAttendanceDoc(incoming(), logId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/students/$(incoming().studentId));
      allow update: if isVerifiedUser() && isValidId(logId) &&
        isValidAttendanceDoc(incoming(), logId) &&
        incoming().id == existing().id &&
        incoming().studentId == existing().studentId &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            existing().authorId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'catatan', 'petugas', 'updatedAt'])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(logId) && isAdmin();
    }

    // 7. /pembinaan_records/{recordId}
    match /pembinaan_records/{recordId} {
      allow get: if isVerifiedUser() && isValidId(recordId) && (existing().authorId == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.authorId == request.auth.uid || isBootstrappedAdmin());
      allow create: if isVerifiedUser() && isValidId(recordId) &&
        isValidPembinaanDoc(incoming(), recordId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/students/$(incoming().studentId));
      allow update: if isVerifiedUser() && isValidId(recordId) &&
        isValidPembinaanDoc(incoming(), recordId) &&
        incoming().id == existing().id &&
        incoming().studentId == existing().studentId &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            existing().authorId == request.auth.uid &&
            existing().statusTindakLanjut != 'Selesai' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'uraian', 'tindakLanjut', 'statusTindakLanjut', 'poin', 'updatedAt'
            ])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(recordId) && isAdmin();
    }
  }
}
