const alasanAlfa = [ "Alfa - Terlambat Masuk Kelas", "Alfa - Terlambat Bangun", "Alfa - Bolos / Keluar Asrama Tanpa Izin", "Alfa - Ketiduran di Kamar / Masjid", "Alfa - Tanpa Keterangan (Tidak Ada Kabar)", "Alfa - Masih di Luar / Kantin", "Alfa - Izin Kadaluarsa (Belum Kembali)" ];
const namaHari = ["MINGGU", "SENIN", "SELASA", "RABU", "KAMIS", "JUMAT", "SABTU"];
let globalSiswaData = [];
let globalOptions = {};
let myChart = null;
let dashboardChart = null; 
let currentJenisPresensi = "Asrama";
let globalMonitoringData = null; 
let globalSiswaUjian = [];
document.addEventListener('click', function(event) {
    if (!event.target.closest('.w-100.mt-1') && !event.target.closest('.radio-group')) {
        document.querySelectorAll('.alasan-box').forEach(b => b.style.display = 'none');
    }
});
window.onload = function() {
    document.getElementById('tanggal').valueAsDate = new Date();
    document.getElementById('tglPiket').valueAsDate = new Date();
    document.getElementById('tglMonitoring').valueAsDate = new Date();
    document.getElementById('tglInval').valueAsDate = new Date();
    updateHariOtomatis();
    updateHariGlobal();
    ubahLabelRole();
};
function updateHariGlobal() {
    let tp = document.getElementById('tglPiket').value;
    if(tp) document.getElementById('hariPiket').innerText = `(${namaHari[new Date(tp).getDay()]})`;
    let ti = document.getElementById('tglInval').value;
    if(ti) document.getElementById('hariInval').innerText = `(${namaHari[new Date(ti).getDay()]})`;
    let tm = document.getElementById('tglMonitoring').value;
    if(tm) document.getElementById('hariMonitoring').innerText = `(${namaHari[new Date(tm).getDay()]})`;
}
function setJenis(jenis, elem) {
    document.getElementById('jenisPresensi').value = jenis;
    currentJenisPresensi = jenis;
    document.querySelectorAll('.presensi-tab').forEach(el => el.classList.remove('active'));
    elem.classList.add('active');
    ubahLabelRole();
}
function geserTanggal(n) { let t = document.getElementById('tanggal'), d = new Date(t.value); d.setDate(d.getDate() + n); t.valueAsDate = d; updateHariOtomatis(); }
function geserTanggalPiket(n) { let t = document.getElementById('tglPiket'), d = new Date(t.value); d.setDate(d.getDate() + n); t.valueAsDate = d; updateHariGlobal(); loadDaftarGuruAbsen(); }
function geserTanggalMonitoring(n) { let t = document.getElementById('tglMonitoring'), d = new Date(t.value); d.setDate(d.getDate() + n); t.valueAsDate = d; updateHariGlobal(); loadMonitoringData(); }
function updateHariOtomatis() { document.getElementById('hari').value = namaHari[new Date(document.getElementById('tanggal').value).getDay()]; muatOpsiBerdasarkanPeran(); }
function getGenderVal() { let r = document.querySelector('input[name="genderSiswa"]:checked'); return r ? r.value : "Putri"; }
function ubahLabelRole() {
    let jenis = document.getElementById("jenisPresensi").value;
    let gender = getGenderVal();
    if (jenis === "Asrama") {
        document.getElementById("labelGuru").innerText = (gender === "Putra") ? "MUSYRIF" : "MUSYRIFAH";
        document.getElementById("namaGuru").placeholder = "Ketik Nama Wali Asrama...";
        document.getElementById("divPilihanTarget").style.display = "block";
        document.getElementById("labelTarget").innerText = "PILIH KAMAR";
        document.getElementById("divMateri").style.display = "block";
        document.getElementById("labelMateri").innerText = "CATATAN ASRAMA";
    } else if (jenis === "Al-Quran") {
        document.getElementById("labelGuru").innerText = "PENGAMPU AL-QUR'AN";
        document.getElementById("namaGuru").placeholder = "Ketik Nama Pengampu...";
        document.getElementById("divPilihanTarget").style.display = "block";
        document.getElementById("labelTarget").innerText = "KELOMPOK AL-QUR'AN";
        document.getElementById("divMateri").style.display = "none";
    } else {
        document.getElementById("labelGuru").innerText = "GURU PENGAJAR";
        document.getElementById("namaGuru").placeholder = "Ketik Nama Guru...";
        document.getElementById("divPilihanTarget").style.display = "block";
        document.getElementById("labelTarget").innerText = "JADWAL KELAS";
        document.getElementById("divMateri").style.display = "block";
        document.getElementById("labelMateri").innerText = "MATERI PEMBELAJARAN";
    }
    document.getElementById("targetGrup").innerHTML = '<option value="">-- LENGKAPI DATA --</option>';
    document.getElementById("namaGuru").value = "";
    kosongkanLayar();
    google.script.run.withSuccessHandler(function(res){
        let list = document.getElementById("listGuru");
        list.innerHTML = "";
        res.forEach(nama => { let opt = document.createElement('option'); opt.value = nama; list.appendChild(opt); });
    }).getListGuru(jenis, gender);
}
function loadTabPiket(elem) {
    document.querySelectorAll('.presensi-tab').forEach(el => el.classList.remove('active'));
    elem.classList.add('active');
    google.script.run.withSuccessHandler(function(res){
        let list = document.getElementById("listSemuaGuru");
        list.innerHTML = "";
        res.forEach(nama => { let opt = document.createElement('option'); opt.value = nama; list.appendChild(opt); });
    }).getListGuru("Semua", "Semua");
    loadDaftarGuruAbsen();
}
function loadTabInval(elem) {
    document.querySelectorAll('.presensi-tab').forEach(el => el.classList.remove('active'));
    elem.classList.add('active');
}
function resetTabelInval() { document.getElementById('tableGuruInval').innerHTML = '<tr><td colspan="3" class="text-center py-4 fw-bolder text-secondary">Silakan tentukan tanggal & pilih jam untuk mencari...</td></tr>'; }
function cariGuruKosong() {
    let tgl = document.getElementById('tglInval').value, gender = document.getElementById('genderInval').value, jenjang = document.getElementById('jenjangInval').value;
    let cbs = document.querySelectorAll('.jam-inval-cb:checked');
    if(!tgl || cbs.length === 0) { alert("Harap pilih tanggal dan centang minimal SATU jam pelajaran!"); return; }
    let jamArrStr = Array.from(cbs).map(cb => cb.value).join(",");
    let tb = document.getElementById('tableGuruInval');
    tb.innerHTML = '<tr><td colspan="3" class="text-center py-4"><span class="spinner-border text-primary"></span> Menganalisis jadwal...</td></tr>';
    google.script.run.withSuccessHandler(res => {
        if(res.length === 0) { tb.innerHTML = '<tr><td colspan="3" class="text-center py-4 text-danger fw-bolder">Tidak ada guru yang kosong sesuai filter pada jam tersebut.</td></tr>'; } 
        else {
            let html = '';
            res.forEach((g, i) => { html += `<tr><td class="text-center">${i+1}</td><td class="fw-bolder text-uppercase">${g}</td><td class="text-center"><a href="https://wa.me/" target="_blank" class="btn btn-sm btn-success"><i class="bi bi-whatsapp"></i> Hubungi</a></td></tr>`; });
            tb.innerHTML = html;
        }
    }).getGuruKosong(tgl, jamArrStr, gender, jenjang);
}
function simpanAbsenPiket() {
    let tgl = document.getElementById('tglPiket').value, nama = document.getElementById('namaGuruPiket').value, status = document.querySelector('input[name="statusPiket"]:checked').value, ket = document.getElementById('ketPiket').value;
    if(!nama) { alert("Harap ketik atau pilih nama guru terlebih dahulu!"); return; }
    let btn = document.getElementById('btnSimpanPiket');
    btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>MENYIMPAN...';
    let req = { tanggal: tgl, namaGuru: nama, status: status, keterangan: ket };
    google.script.run.withSuccessHandler(function(msg) {
        if(msg.includes("ERROR")) { alert(msg); }
        else { document.getElementById('namaGuruPiket').value = ""; document.getElementById('ketPiket').value = ""; loadDaftarGuruAbsen(); }
        btn.disabled = false; btn.innerHTML = '<i class="bi bi-send-fill me-2"></i>SIMPAN DATA GURU';
    }).simpanGuruAbsen(req);
}
function loadDaftarGuruAbsen() {
    let tgl = document.getElementById('tglPiket').value, tb = document.getElementById('tableGuruAbsen');
    tb.innerHTML = '<tr><td colspan="4" class="text-center py-4"><span class="spinner-border text-danger"></span></td></tr>';
    google.script.run.withSuccessHandler(function(res) {
        if(res.length === 0) { tb.innerHTML = '<tr><td colspan="4" class="text-center py-4">Belum ada guru yang dilaporkan absen hari ini.</td></tr>'; } 
        else {
            let html = '';
            res.forEach((g, i) => {
                let badge = 'bg-danger';
                if(g.status === 'Sakit') badge = 'bg-warning text-dark';
                if(g.status === 'Izin' || g.status === 'Dinas Luar') badge = 'bg-info text-dark';
                html += `<tr><td class="text-center">${i+1}</td><td class="text-uppercase">${g.nama}</td><td class="text-center"><span class="badge ${badge}">${g.status}</span></td><td>${g.ket}</td></tr>`;
            });
            tb.innerHTML = html;
        }
    }).getGuruAbsenHariIni(tgl);
}
function showBroadcastHarian() {
    let tgl = document.getElementById('tglPiket').value, gender = document.querySelector('input[name="genderBroadcast"]:checked').value, btn = document.querySelector('.btn-warning');
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>MEMBUAT TEKS...';
    google.script.run.withSuccessHandler(res => {
        btn.innerHTML = '<i class="bi bi-megaphone-fill me-1"></i> BUAT TEKS BROADCAST'; document.getElementById('teksBroadcast').value = res;
        new bootstrap.Modal(document.getElementById('modalBroadcast')).show();
    }).getBroadcastHarian(tgl, gender);
}
function copyBroadcast() { document.getElementById("teksBroadcast").select(); document.execCommand("copy"); alert("Teks berhasil disalin! Silakan tempel di grup WhatsApp Wali Murid."); }
function muatOpsiBerdasarkanPeran() {
    let jenis = document.getElementById("jenisPresensi").value, gender = getGenderVal(), nama = document.getElementById("namaGuru").value, tgl = document.getElementById("tanggal").value, selectTarget = document.getElementById("targetGrup");
    if(!nama || !tgl) return;
    if (jenis === "Asrama") {
        selectTarget.innerHTML = '<option value="">Memuat...</option>'; kosongkanLayar();
        google.script.run.withSuccessHandler(function(rooms) {
            selectTarget.innerHTML = '<option value="">-- PILIH KAMAR --</option>';
