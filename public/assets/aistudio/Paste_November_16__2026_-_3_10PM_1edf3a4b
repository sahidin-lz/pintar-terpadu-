        }
        let csvFile = new Blob([csv.join("\n")], {type: "text/csv;charset=utf-8;"}), downloadLink = document.createElement("a");
        downloadLink.download = `Data_Presensi_${divisi.toUpperCase()}_${jenis.toUpperCase()}_${new Date().getTime()}.csv`; downloadLink.href = window.URL.createObjectURL(csvFile);
