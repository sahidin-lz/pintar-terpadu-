function buildMatrixTable(arr) {
    if(arr.length === 0) return '<div class="text-center py-4 fw-bolder text-secondary">TIDAK ADA JADWAL HARI INI</div>';
    let uniqueKelas = Array.from(new Set(arr.map(x => x.kelas))).sort();
    let thead = `<thead><tr><th style="width:60px; background:#f8fafc; border-color:#e2e8f0;">JAM</th>`;
    uniqueKelas.forEach(k => thead += `<th>${k}</th>`); thead += `</tr></thead>`;
    let parsedArr = arr.map(x => { let parts = x.jam.split('-'); return { ...x, start: parseInt(parts[0]), span: parts.length > 1 ? (parseInt(parts[1]) - parseInt(parts[0]) + 1) : 1 }; });
    let minHour = Math.min(...parsedArr.map(x => x.start)), maxHour = Math.max(...parsedArr.map(x => x.start + x.span - 1));
    let skipGrid = {}; for(let h = minHour; h <= maxHour; h++) { skipGrid[h] = {}; uniqueKelas.forEach(k => skipGrid[h][k] = false); }
    let tbody = `<tbody>`;
    for(let h = minHour; h <= maxHour; h++) {
        tbody += `<tr><td class="jam-col">${h}</td>`;
        uniqueKelas.forEach(k => {
            if (skipGrid[h][k]) return;
            let item = parsedArr.find(x => x.start === h && x.kelas === k);
            if(item) {
                for(let s = 1; s < item.span; s++) { if(skipGrid[h+s] !== undefined) { skipGrid[h+s][k] = true; } }
                let badge = "";
                if(item.status === 'HADIR') badge = `<span class="badge bg-success badge-status shadow-sm"><i class="bi bi-check-circle-fill me-1"></i>SUDAH DIISI</span>`;
                else if(item.status === 'GURU_ABSEN') badge = `<span class="badge bg-warning text-dark badge-status shadow-sm"><i class="bi bi-person-x-fill me-1"></i>GURU ABSEN</span>`;
                else badge = `<span class="badge bg-danger badge-status shadow-sm"><i class="bi bi-exclamation-circle-fill me-1"></i>BELUM DIISI</span>`;
                tbody += `<td rowspan="${item.span}" style="background-color: #ffffff;"><div class="cell-mapel">${item.mapel}</div><div class="cell-guru"><i class="bi bi-person-fill me-1"></i>${item.guru}</div>${badge}</td>`;
            } else { tbody += `<td class="empty-cell">-</td>`; }
        }); tbody += `</tr>`;
    } tbody += `</tbody>`;
    return `<div class="table-responsive"><table class="table-matriks">${thead}${tbody}</table></div>`;
}
function buildAsramaGrid(arr) {
    if(arr.length === 0) return '<div class="text-center py-4 fw-bolder text-secondary">TIDAK ADA DATA KAMAR</div>';
    let html = '<div class="row g-2">';
    arr.forEach(item => {
        let badge = "", bg = "bg-white", border = "border-secondary-subtle";
        if(item.status === 'HADIR') { badge = `<span class="badge bg-success shadow-sm w-100 py-2" style="font-size:10px;"><i class="bi bi-check-circle-fill me-1"></i>SUDAH DIISI</span>`; border = "border-success"; }
        else if(item.status === 'GURU_ABSEN') { badge = `<span class="badge bg-warning text-dark shadow-sm w-100 py-2" style="font-size:10px;"><i class="bi bi-person-x-fill me-1"></i>MUSYRIF ABSEN</span>`; border = "border-warning"; }
        else { badge = `<span class="badge bg-danger shadow-sm w-100 py-2" style="font-size:10px;"><i class="bi bi-exclamation-circle-fill me-1"></i>BELUM DIISI</span>`; border = "border-danger"; }
        html += `<div class="col-6 col-md-4 col-lg-3"><div class="border ${border} rounded p-3 text-center h-100 shadow-sm d-flex flex-column justify-content-between" style="background:#f8fafc;">
                <div><h6 class="fw-bolder mb-1" style="color:#0f172a; font-size:13px;">${item.kamar}</h6><div class="text-truncate mb-2" style="font-size:10px; color:#64748b;" title="${item.musyrif}"><i class="bi bi-person-fill me-1"></i>${item.musyrif}</div></div>${badge}</div></div>`;
    });
    html += '</div>'; return html;
}
