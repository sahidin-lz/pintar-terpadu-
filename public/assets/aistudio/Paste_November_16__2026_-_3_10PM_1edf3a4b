<script>
  // GANTI TEKS DI BAWAH INI DENGAN URL WEB APP GOOGLE SCRIPT ANDA
  const GAS_WEB_APP_URL = "ISI_DENGAN_URL_WEB_APP_ANDA_DISINI";

  // Jembatan API agar kode google.script.run asli tetap bekerja
  const google = {
    script: {
      run: {
        withSuccessHandler: function(onSuccess) {
          return new Proxy({}, {
            get: function(target, functionName) {
              return function(...args) {
                fetch(GAS_WEB_APP_URL, {
                  method: 'POST',
                  headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                  body: JSON.stringify({ functionName: functionName, args: args })
                })
                .then(response => response.json())
                .then(res => {
                  if (res.error) console.error("Apps Script Error:", res.error);
                  else if (onSuccess) onSuccess(res.result);
                })
                .catch(err => console.error("Fetch Error:", err));
              };
            }
          });
        }
      }
    }
  };
</script>
