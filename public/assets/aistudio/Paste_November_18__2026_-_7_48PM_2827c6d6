    function downloadDenah() {
      showLoader("Menyiapkan PDF Denah...");
      const plotMap = {};
      (state.ploting || []).forEach(p => { if(p.kampus === viewKampus && p.lokasi === currentPlotingRuang) plotMap[parseInt(p.no_pc, 10)] = p; });
      const themeColors = ['#3b82f6', '#10b981', '#8b5cf6', '#f43f5e', '#f59e0b', '#06b6d4', '#d946ef'];
      
      let html = `<html><head><style>@page { size: A4 portrait; margin: 10mm; } body { font-family: sans-serif; } .plot-table { width: 100%; border-spacing: 6px; table-layout: fixed; } .plot-cell { border-radius: 12px; padding: 6px; height: 155px; text-align: center; color: white; } .pc-number { font-weight: 900; font-size: 12px; background: rgba(255,255,255,0.3); padding: 3px 6px; border-radius: 4px; display: inline-block; margin-bottom: 8px;} .student-name { font-weight: 900; font-size: 11.5px; text-transform: uppercase; } .student-class { font-size: 9px; margin-top: 6px; background: rgba(0,0,0,0.25); padding: 3px 5px; border-radius: 4px; display: inline-block; } .empty-cell { background: #f8fafc; border: 2px dashed #cbd5e1; height: 155px; text-align: center; color: #cbd5e1; font-weight: 900; font-size: 18px; }</style></head><body><div style="text-align:center"><h1 style="margin-bottom:5px;">DENAH ${escapeHTML(currentPlotingRuang)}</h1><p>KAMPUS ${viewKampus}</p><div style="background:#f1f5f9;border:2px solid #cbd5e1;padding:12px;font-weight:900;letter-spacing:6px;margin:15px 0;">PAPAN TULIS / MEJA GURU</div><table class="plot-table">`;
      let pc = 1;
      for(let r=0; r<5; r++) { 
        html += `<tr>`;
        for(let c=0; c<8; c++) { 
          let p = plotMap[pc];
          if(p) {
            let nSiswa = p.nama_siswa || p.nama || "-"; let kSiswa = p.kelas || p.nama_kelas || "-";
            let hash = 0; for (let i = 0; i < nSiswa.length; i++) { hash = nSiswa.charCodeAt(i) + ((hash << 5) - hash); }
            let bgColor = themeColors[Math.abs(hash) % themeColors.length];
            html += `<td class="plot-cell" style="background-color: ${bgColor};"><div class="pc-number">${pc}</div><div class="student-name">${escapeHTML(nSiswa)}</div><div class="student-class">${escapeHTML(kSiswa)}</div></td>`;
          } else { html += `<td class="empty-cell">${pc}</td>`; }
          pc++;
        }
        html += `</tr>`;
      }
      html += `</table></div></body></html>`;
      google.script.run.withSuccessHandler(res => { hideLoader(); if(res.success){ const l = document.createElement('a'); l.href = 'data:application/pdf;base64,' + res.data; l.download = res.fileName; l.click(); } }).generateDenahPDF(html, viewKampus, currentPlotingRuang);
    }


