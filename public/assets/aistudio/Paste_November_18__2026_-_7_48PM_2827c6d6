                  <thead class="bg-slate-50 border-b-2 border-slate-100"><tr><th class="p-5 text-[11px] font-black uppercase text-slate-400">Area & Hari</th><th class="p-5 text-[11px] font-black uppercase text-slate-400">Lokasi / Waktu</th><th class="p-5 text-[11px] font-black uppercase text-slate-400">Keterangan</th><th class="p-5 text-[11px] font-black uppercase text-slate-400 text-center">Aksi</th></tr></thead>
                  <tbody class="divide-y divide-slate-100">
                    ${(state.jadwal_tetap || []).map(r => `
                      <tr class="hover:bg-slate-50 transition-colors">
                        <td class="p-5"><span class="${r.kampus==='PUTRA'?'bg-blue-100 text-blue-700':'bg-fuchsia-100 text-fuchsia-700'} px-3 py-1 rounded-md text-[10px] font-black uppercase block w-fit mb-2">${r.kampus}</span><span class="text-sm font-black text-amber-600 uppercase">${hariMap[r.hari]}</span></td>
                        <td class="p-5"><div class="flex flex-col gap-2"><span class="${bgColors[getHashNum(r.lab)]} text-white px-3 py-1.5 rounded-lg text-xs font-black w-fit">${escapeHTML(r.lab)}</span> <span class="bg-slate-200 text-slate-800 px-3 py-1.5 rounded-lg text-xs font-black w-fit">JAM ${r.jam_ke}</span></div></td>
                        <td class="p-5"><p class="font-black text-sm uppercase text-slate-800">${escapeHTML(r.mapel)}</p><p class="text-xs font-bold text-slate-500 mt-1">${escapeHTML(r.guru)} • <span class="text-slate-700">${escapeHTML(r.kelas)}</span></p></td>
                        <td class="p-5 text-center"><button onclick="handleDel('${r.id}', 'Jadwal_Tetap')" class="bg-rose-50 text-rose-600 px-4 py-2 rounded-lg font-black text-[10px] uppercase">HAPUS</button></td>
                      </tr>
                    `).join('')}
                  </tbody>
                </table>
             </div>
          </div>
        </div>
      </div>`;
      el.innerHTML = html;
    }

    function renderMaster(el) {
      const cats = ['GURU', 'KELAS', 'MAPEL', 'LAB', 'RUANGAN', 'JAM', 'WAKTU_RUANG'];
      let html = `<div class="space-y-6 fade-in max-w-7xl mx-auto"><div class="bg-slate-800 text-white p-10 rounded-3xl shadow-lg flex flex-col md:flex-row justify-between items-center gap-4"><div><h2 class="text-3xl font-black uppercase">Master Data Terpisah</h2></div><button onclick="refreshData()" class="bg-white text-slate-900 px-6 py-4 rounded-xl font-black text-[11px] uppercase">Segarkan Sistem</button></div><div class="grid grid-cols-1 md:grid-cols-12 gap-6"><div class="md:col-span-4 bg-white rounded-3xl shadow-sm border border-slate-100 p-8 h-fit sticky top-24"><h3 class="font-black text-sm uppercase mb-6">Tambah Cepat</h3><form onsubmit="handleMasterSubmit(event)" class="space-y-4"><div><label class="text-[10px] font-black uppercase text-slate-500">Kategori</label><select name="kategori" class="w-full mt-2 p-4 border-2 border-slate-200 rounded-xl font-bold text-sm bg-white">${cats.map(c=>`<option value="${c}">${c}</option>`).join('')}</select></div><div><label class="text-[10px] font-black uppercase text-slate-500">Nilai (Nama)</label><input required name="nilai" class="w-full mt-2 p-4 border-2 border-slate-200 rounded-xl font-bold text-sm" /></div><button class="w-full bg-slate-800 text-white font-black py-4 rounded-xl uppercase text-[11px] mt-2 shadow-lg">Simpan Data</button></form></div><div class="md:col-span-8 grid grid-cols-1 sm:grid-cols-2 gap-5">`;
      cats.forEach(c => {
        const list = getM(c); let targetSheet = '';
        if(c==='GURU') targetSheet = 'Master_Guru'; else if(c==='KELAS') targetSheet = 'Master_Kelas'; else if(c==='MAPEL') targetSheet = 'Master_Mapel'; else if(c==='LAB' || c==='RUANGAN') targetSheet = 'Master_Ruang'; else targetSheet = 'Master_Waktu';
        html += `<div class="bg-white rounded-3xl shadow-sm border border-slate-100 flex flex-col h-[300px] overflow-hidden"><div class="bg-slate-50 p-5 border-b border-slate-100 flex justify-between items-center"><span class="text-[11px] font-black uppercase tracking-wider">${c}</span><span class="bg-white border text-[10px] px-3 py-1 rounded-md font-black shadow-sm text-slate-500">${list.length}</span></div><div class="overflow-y-auto flex-1 p-3 custom-scrollbar divide-y divide-slate-50">`;
        list.forEach(m => { html += `<div class="p-3 flex justify-between items-center hover:bg-slate-50 transition-colors rounded-xl font-bold text-[12px] group"><span class="truncate">${escapeHTML(m.nilai)}</span><div class="flex gap-2 opacity-0 group-hover:opacity-100"><button onclick="handleEditMaster('${m.id}', '${targetSheet}', '${escapeHTML(m.nilai)}')" class="text-amber-600 font-black text-[10px] bg-amber-50 px-3 py-1.5 rounded-lg">Edit</button><button onclick="handleDel('${m.id}', '${targetSheet}')" class="text-rose-500 font-black text-[10px] bg-rose-50 px-3 py-1.5 rounded-lg">Hapus</button></div></div>`; });
        html += `</div></div>`;
      });
      html += `</div></div></div>`; el.innerHTML = html;
    }

    // ==========================================
    // 9. HISTORY (MULTI-DELETE)
    // ==========================================
    function toggleAllHistory(el) { document.querySelectorAll('.history-checkbox').forEach(cb => cb.checked = el.checked); }

    function hapusHistoryTerpilih() {
      const checkboxes = document.querySelectorAll('.history-checkbox:checked');
      if(checkboxes.length === 0) return alert("Pilih minimal 1 data!");
      if(!confirm("Yakin ingin menghapus " + checkboxes.length + " data?")) return;
      let itemsToDelete = []; checkboxes.forEach(cb => { itemsToDelete.push(JSON.parse(cb.value)); });
      showLoader("Menghapus Data Terpilih...");
      google.script.run.withSuccessHandler(res => { if(res.success) { refreshData(); alert(res.message); } else { alert(res.message); hideLoader(); } }).deleteMultipleData(itemsToDelete);
    }

    function renderHistory(el) {
      let combined = (state.db||[]).map(x=>({...x, from:'PUTRA'})).concat((state.db_putri||[]).map(x=>({...x, from:'PUTRI'})));
      combined.sort((a,b) => new Date(b.timestamp) - new Date(a.timestamp));
      let html = `
      <div class="space-y-6 fade-in max-w-6xl mx-auto">
        <div class="bg-slate-800 text-white rounded-3xl shadow-lg border p-8 flex flex-col sm:flex-row justify-between items-center gap-4"><h2 class="text-2xl font-black uppercase">Riwayat Keseluruhan</h2><button onclick="hapusHistoryTerpilih()" class="bg-rose-500 hover:bg-rose-600 text-white px-5 py-2.5 rounded-xl font-black text-[11px] uppercase transition-all shadow-md">Hapus Terpilih</button></div>
        <div class="bg-white rounded-3xl shadow-sm border overflow-hidden w-full"><div class="overflow-x-auto custom-scrollbar p-2"><table class="w-full text-left min-w-[800px] border-collapse"><thead class="bg-slate-50 border-b-2 border-slate-100"><tr><th class="p-5 w-12 text-center"><input type="checkbox" onclick="toggleAllHistory(this)" class="w-4 h-4 cursor-pointer accent-blue-600"></th><th class="p-5 text-[11px] font-black text-slate-400 uppercase tracking-widest">KAMPUS</th><th class="p-5 text-[11px] font-black text-slate-400 uppercase tracking-widest">PEMINJAM & GURU</th><th class="p-5 text-[11px] font-black text-slate-400 uppercase tracking-widest">JADWAL & WAKTU</th><th class="p-5 text-[11px] font-black text-slate-400 uppercase tracking-widest text-center">AKSI</th></tr></thead><tbody class="divide-y divide-slate-100">
        ${combined.map(r => `
        <tr class="hover:bg-slate-50 transition-colors"><td class="p-5 text-center"><input type="checkbox" class="history-checkbox w-4 h-4 cursor-pointer accent-blue-600" value='{"id":"${r.id}", "sheet":"${r.from==='PUTRA'?'Data_Pinjam':'Data_Pinjam_Putri'}"}'></td><td class="p-5"><span class="${r.from==='PUTRA'?'bg-blue-100 text-blue-700':'bg-fuchsia-100 text-fuchsia-700'} px-3 py-1.5 rounded-lg text-[10px] font-black uppercase">${r.from}</span></td><td class="p-5"><p class="font-black uppercase text-[13px] text-slate-800">${escapeHTML(r.nama_peminjam)}</p><p class="text-[11px] font-bold text-slate-500 uppercase mt-1">${escapeHTML(r.guru)} • ${escapeHTML(r.kelas)}</p></td><td class="p-5"><div class="flex items-center gap-2 mb-2"><span class="${bgColors[getHashNum(r.lab)]} text-white text-[10px] font-black px-2.5 py-1 rounded-md">${escapeHTML(r.lab)}</span><span class="bg-slate-200 text-slate-700 text-[10px] font-black px-2.5 py-1 rounded-md">JAM ${r.jam_ke}</span></div><p class="text-[11px] font-black uppercase text-slate-600">${escapeHTML(r.mapel)}</p><p class="text-[10px] font-bold text-slate-400 mt-0.5">${r.tanggal}</p></td><td class="p-5 text-center"><button onclick="handleDel('${r.id}', '${r.from==='PUTRA'?'Data_Pinjam':'Data_Pinjam_Putri'}')" class="bg-rose-50 text-rose-600 px-4 py-2 rounded-lg font-black text-[10px] uppercase">HAPUS</button></td></tr>`).join('')}
        </tbody></table></div></div></div>`;
      el.innerHTML = html;
    }

    // ==========================================
    // 10. LOGIN
    // ==========================================
    function renderLogin(el) { 
      el.innerHTML = `<div class="max-w-sm mx-auto pt-24 fade-in"><div class="bg-white rounded-3xl p-10 text-center shadow-[0_8px_30px_rgb(0,0,0,0.08)] border border-slate-100"><h2 class="text-2xl font-black mb-8 uppercase tracking-widest text-slate-800">Admin Login</h2><form onsubmit="handleLogin(event)" class="space-y-4"><input required name="username" placeholder="Username" class="w-full p-4 border-2 border-slate-200 rounded-xl font-bold outline-none" autocomplete="off"/><input required name="password" type="password" placeholder="Password" class="w-full p-4 border-2 border-slate-200 rounded-xl font-bold outline-none" /><button class="w-full bg-slate-800 text-white font-black py-4 rounded-xl uppercase text-[12px] mt-4 shadow-lg">Login</button></form></div></div>`; 
    }

    // ==========================================
    // ACTIONS & HANDLERS
    // ==========================================
    function handleJadwalTetap(e) { e.preventDefault(); if(selectedJams.length === 0) return alert("Pilih jam!"); showLoader("Menyimpan Jadwal..."); google.script.run.withSuccessHandler(res => { if(res.success){ selectedJams = []; refreshData(); } else { alert(res.message); hideLoader(); } }).simpanJadwalTetap(Object.fromEntries(new FormData(e.target).entries())); }
    function handleBooking(e) { e.preventDefault(); if(selectedJams.length === 0) return alert("Pilih jam!"); showLoader("Memproses Booking..."); google.script.run.withSuccessHandler(res => { if(res.success) { selectedJams = []; refreshData(); show('dashboard'); } else { alert(res.message); hideLoader(); } }).simpanBooking(Object.fromEntries(new FormData(e.target).entries())); }
    
    function handleBookingMassal(e) { 
      e.preventDefault(); 
      if(selectedJams.length === 0) return alert("Pilih minimal satu waktu/jam!");
      
      var form = e.target;
      var startDateStr = form.querySelector('[name="tgl_mulai"]').value;
      var endDateStr = form.querySelector('[name="tgl_selesai"]').value;
      
      var selectedDays = [];
      var checkboxes = form.querySelectorAll('input[name="hari"]:checked');
      for(var i = 0; i < checkboxes.length; i++){ selectedDays.push(Number(checkboxes[i].value)); }
      if(selectedDays.length === 0) return alert("Pilih minimal satu hari dalam seminggu!");

      var startParts = startDateStr.split('-');
      var curr = new Date(startParts[0], startParts[1] - 1, startParts[2]);
      var endParts = endDateStr.split('-');
      var end = new Date(endParts[0], endParts[1] - 1, endParts[2]);
      
      if (curr > end) return alert("Tanggal mulai tidak boleh melewati tanggal sampai!");

      var list = [];
      while(curr <= end) { 
        if(selectedDays.includes(curr.getDay() === 0 ? 7 : curr.getDay())) { 
          var y = curr.getFullYear();
          var m = String(curr.getMonth() + 1).padStart(2, '0');
          var d = String(curr.getDate()).padStart(2, '0');
          list.push(y + '-' + m + '-' + d); 
        } 
        curr.setDate(curr.getDate() + 1); 
      }
      
      if(list.length === 0) return alert("Tidak ada tanggal yang cocok dalam rentang tersebut.");
      if(!confirm("Sistem akan memesan jadwal untuk " + list.length + " hari yang berbeda. Lanjutkan?")) return;
      
      var pObj = {};
      var fd = new FormData(form);
      fd.forEach(function(val, key) { pObj[key] = val; });
      pObj.jam_ke = selectedJams.join(',');
      pObj.tanggalList = list;

      showLoader("Memproses " + list.length + " Hari...");
      google.script.run
        .withFailureHandler(function(err){ alert("Error Sistem: " + err.message); hideLoader(); })
        .withSuccessHandler(function(res){ alert(res.message); refreshData(); show('dashboard'); })
        .simpanBookingMassal(pObj);
    }
    
    function handleMasterSubmit(e) { e.preventDefault(); showLoader("Menyimpan Master..."); google.script.run.withSuccessHandler(() => refreshData()).saveMaster(Object.fromEntries(new FormData(e.target).entries())); }
    function handleEditMaster(id, sheetName, currentValue) { const newVal = prompt("Edit Data:", currentValue); if (newVal === null || newVal.trim() === "" || newVal === currentValue) return; showLoader("Memperbarui Data..."); google.script.run.withSuccessHandler(res => { if(res.success) refreshData(); else { alert(res.message); hideLoader(); } }).updateData(id, sheetName, { "nilai": newVal }); }
    function handleDel(id, sh) { if(!confirm("Yakin hapus data ini dari database?")) return; showLoader("Menghapus Data..."); google.script.run.withSuccessHandler(() => refreshData()).deleteData(id, sh); }
    function handleLogin(e) { e.preventDefault(); showLoader("Checking..."); google.script.run.withSuccessHandler(res => { if(res.success){ user = res.user; localStorage.setItem('_xf_auth_2026_xyz', JSON.stringify(res.user)); updateUI(); hideLoader(); show('dashboard'); } else { alert(res.message); hideLoader(); } }).loginUser(Object.fromEntries(new FormData(e.target).entries())); }
    function logout() { localStorage.removeItem('_xf_auth_2026_xyz'); user = null; updateUI(); show('dashboard'); }
  </script>
</body>
</html>