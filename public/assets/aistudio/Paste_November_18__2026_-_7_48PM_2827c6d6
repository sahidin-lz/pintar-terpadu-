<!DOCTYPE html>
<html lang="id">
<head>
  <base target="_top">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SIM Ruangan As-Syifa</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap');
    
    body { 
      font-family: 'Plus Jakarta Sans', sans-serif; 
      background-color: #f1f5f9; 
      color: #0f172a; 
      margin: 0; 
      min-height: 100vh; 
      overflow-x: hidden; 
    }
    
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
    ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

    .glass-nav { 
      background: rgba(255, 255, 255, 0.85); 
      backdrop-filter: blur(12px); 
      border-bottom: 1px solid rgba(226, 232, 240, 0.8); 
    }
    
    .nav-active { 
      background: #1e293b !important; 
      color: #ffffff !important; 
      box-shadow: 0 4px 15px rgba(15, 23, 42, 0.2); 
    }
    
    .fade-in { animation: fadeIn 0.4s cubic-bezier(0.4, 0, 0.2, 1) forwards; }
    @keyframes fadeIn { 
      from { opacity: 0; transform: translateY(10px); } 
      to { opacity: 1; transform: translateY(0); } 
    }
    
    .card-hover { transition: all 0.3s ease; }
    .card-hover:hover { 
      transform: translateY(-3px); 
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04); 
    }
    
    .btn-hour, .btn-day { 
      transition: all 0.2s; 
      border: 1px solid #cbd5e1; 
      background: #ffffff; 
      color: #475569; 
      cursor: pointer; 
    }
    .btn-hour:hover, .btn-day:hover { 
      border-color: #3b82f6; 
      color: #3b82f6; 
      background: #eff6ff; 
    }
    .btn-hour.selected, .btn-day.selected { 
      background: #1e293b !important; 
      color: white !important; 
      border-color: transparent; 
      box-shadow: 0 8px 15px rgba(15, 23, 42, 0.25); 
      transform: scale(1.02); 
    }
    
    .loader-spin { 
      width: 40px; 
      height: 40px; 
      border: 4px solid #e2e8f0; 
      border-top: 4px solid #3b82f6; 
      border-radius: 50%; 
      animation: spin 0.8s linear infinite; 
    }
    @keyframes spin { 
      0% { transform: rotate(0deg); } 
      100% { transform: rotate(360deg); } 
    }
    
    .modal-overlay { 
      background: rgba(15, 23, 42, 0.6); 
      backdrop-filter: blur(4px); 
    }
  </style>
</head>
<body class="antialiased selection:bg-blue-200 selection:text-blue-900">

  <div id="loader" class="fixed inset-0 modal-overlay z-[999] flex flex-col items-center justify-center transition-all duration-300">
    <div class="bg-white p-8 rounded-3xl shadow-2xl flex flex-col items-center card-hover">
      <div class="loader-spin mb-4"></div>
      <p id="loader-text" class="text-[11px] font-black text-slate-800 uppercase tracking-widest">MEMUAT DATA...</p>
    </div>
  </div>

  <div id="ploting-modal" class="fixed inset-0 modal-overlay z-[900] hidden flex-col items-center justify-center transition-all duration-300 px-4">
    <div class="bg-white p-8 rounded-[2rem] shadow-2xl w-full max-w-md fade-in">
      <div class="flex justify-between items-center mb-6">
        <div>
          <h3 class="font-black text-xl text-slate-800 uppercase tracking-wide">Ploting PC / Kursi</h3>
          <p id="modal-pc-label" class="text-sm font-bold text-slate-500 mt-1">PC No: -</p>
        </div>
        <button onclick="closePlotingModal()" class="w-10 h-10 bg-slate-100 hover:bg-rose-100 text-slate-500 hover:text-rose-600 rounded-full flex items-center justify-center font-black transition-colors">X</button>
      </div>
      
      <form onsubmit="simpanDataPloting(event)" class="space-y-5">
        <input type="hidden" id="plot_no_pc" name="no_pc">
        <div>
          <label class="text-[10px] font-black uppercase text-slate-500 mb-2 block">1. Pilih Kelas Dulu</label>
          <select id="plot_kelas_select" onchange="filterSiswaByKelas()" class="w-full p-4 border-2 border-slate-200 rounded-xl font-bold text-sm bg-slate-50 focus:border-slate-800 outline-none">
          </select>
        </div>
        <div>
          <label class="text-[10px] font-black uppercase text-slate-500 mb-2 block">2. Pilih Nama Siswa</label>
          <select id="plot_siswa_select" name="siswa_data" class="w-full p-4 border-2 border-slate-200 rounded-xl font-bold text-sm bg-white focus:border-slate-800 outline-none">
          </select>
        </div>
        <button type="submit" class="w-full bg-slate-800 hover:bg-slate-900 text-white font-black py-4 rounded-xl uppercase text-[12px] shadow-lg transition-transform hover:-translate-y-1 mt-2">Simpan Posisi</button>
      </form>
    </div>
  </div>

  <nav class="glass-nav h-16 px-4 md:px-8 flex items-center justify-between sticky top-0 z-50">
    <div class="flex items-center gap-3 cursor-pointer group" onclick="show('dashboard')">
      <div class="bg-gradient-to-br from-blue-600 to-indigo-700 p-2 rounded-xl text-white shadow-lg" id="nav-logo">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
          <line x1="8" y1="21" x2="16" y2="21"/>
          <line x1="12" y1="17" x2="12" y2="21"/>
        </svg>
      </div>
      <h1 class="font-black text-[15px] uppercase tracking-tight text-slate-800 hidden sm:block">SIM RUANGAN</h1>
    </div>
    
    <div class="flex gap-2 items-center overflow-x-auto">
      <button onclick="refreshData()" class="px-4 py-2 mr-2 rounded-xl text-[11px] font-black uppercase bg-blue-100 text-blue-700 hover:bg-blue-200 transition-all flex items-center gap-1.5 shadow-sm" title="Sinkron Data">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 2v6h-6"></path><path d="M3 12a9 9 0 1 0 2.13-5.83L21 8"></path></svg>
        <span class="hidden sm:inline">Sinkron Data</span>
      </button>

      <button onclick="show('dashboard')" id="nav-dashboard" class="px-5 py-2 rounded-xl text-[11px] font-bold uppercase text-slate-600 hover:bg-slate-100 transition-all">Status</button>
      <button onclick="show('form')" id="nav-form" class="px-5 py-2 rounded-xl text-[11px] font-bold uppercase text-slate-600 hover:bg-slate-100 transition-all">Booking</button>
      <button onclick="show('rekap')" id="nav-rekap" class="px-5 py-2 rounded-xl text-[11px] font-bold uppercase text-slate-600 hover:bg-slate-100 transition-all">Rekap</button>
      
      <div id="admin-nav" class="hidden flex gap-1 border-l-2 border-slate-200 ml-2 pl-2">
        <button onclick="show('broadcast')" id="nav-broadcast" class="p-2 text-cyan-500 rounded-xl hover:bg-cyan-50 transition-colors" title="Broadcast Telegram"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg></button>
        <button onclick="show('massal')" id="nav-massal" class="p-2 text-violet-500 rounded-xl hover:bg-violet-50 transition-colors" title="Booking Massal"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01M16 18h.01"/></svg></button>
        <button onclick="show('jadwal')" id="nav-jadwal" class="p-2 text-amber-500 rounded-xl hover:bg-amber-50 transition-colors" title="Jadwal Tetap"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg></button>
        <button onclick="show('ploting')" id="nav-ploting" class="p-2 text-pink-500 rounded-xl hover:bg-pink-50 transition-colors" title="Ploting Denah Siswa"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 3h18v18H3z"/><path d="M9 3v18"/><path d="M15 3v18"/><path d="M3 9h18"/><path d="M3 15h18"/></svg></button>
        <button onclick="show('history')" id="nav-history" class="p-2 text-blue-500 rounded-xl hover:bg-blue-50 transition-colors" title="Riwayat"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></button>
        <button onclick="show('master')" id="nav-master" class="p-2 text-slate-500 rounded-xl hover:bg-slate-100 transition-colors" title="Master Data"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1-2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg></button>
        <button onclick="logout()" class="p-2 text-rose-500 rounded-xl hover:bg-rose-50 transition-colors" title="Logout"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></button>
      </div>
      <button onclick="show('login')" id="nav-login" class="p-2 text-slate-400 hover:text-blue-600 transition-colors"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></button>
    </div>
  </nav>

  <main id="root" class="max-w-7xl mx-auto px-4 md:px-8 py-8 fade-in"></main>

  <script>
    function escapeHTML(str) {
      if (!str) return '';
      return str.toString().replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
    }

    const stateInjected = <?!= injectedData ?>;
    let state = stateInjected || { success: false };
    let user = null; 
    let view = 'dashboard'; 
    let viewSub = 'lab'; 
    let viewKampus = 'PUTRA';
    
    let nowTime = new Date();
    let vDate = new Date(nowTime.getTime() - (nowTime.getTimezoneOffset() * 60000)).toISOString().split("T")[0]; 
    
    let selectedJams = [];
    let selectedDays = [];
    let filterBulan = 'ALL';
    let filterSemester = 'ALL';
    
    let currentPlotingRuang = '';

    const hariMap = {1:"Senin", 2:"Selasa", 3:"Rabu", 4:"Kamis", 5:"Jumat", 6:"Sabtu", 7:"Minggu"};
    const bgColors = ['bg-blue-500', 'bg-emerald-500', 'bg-violet-500', 'bg-rose-500', 'bg-amber-500', 'bg-cyan-500', 'bg-fuchsia-500'];
    
    function getHashNum(str) {
      let hash = 0;
      for (let i = 0; i < str.length; i++) { hash = str.charCodeAt(i) + ((hash << 5) - hash); }
      return Math.abs(hash) % bgColors.length;
    }

    function formatTanggalIndo(ds) {
      if(!ds) return "-";
      const p = ds.split('-'); 
      const date = new Date(p[0], p[1]-1, p[2]);
      const months = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
      return `${hariMap[date.getDay()===0?7:date.getDay()]}, ${p[2]} ${months[date.getMonth()]} ${p[0]}`;
    }

    const getM = (k) => {
      let res = [];
      if(k === 'GURU') res = state.master_guru || [];
      else if(k === 'KELAS') res = state.master_kelas || [];
      else if(k === 'MAPEL') res = state.master_mapel || [];
      else if(k === 'LAB') res = (state.master_ruang || []).filter(x => x.kategori === 'LAB');
      else if(k === 'RUANGAN') res = (state.master_ruang || []).filter(x => x.kategori === 'RUANGAN');
      else if(k === 'JAM') res = (state.master_waktu || []).filter(x => x.kategori === 'JAM');
      else if(k === 'WAKTU_RUANG') res = (state.master_waktu || []).filter(x => x.kategori === 'WAKTU_RUANG');
      return res.sort((a,b) => String(a.nilai).localeCompare(String(b.nilai), undefined, {numeric:true}));
    };

    function shiftDate(n) { 
      let d = new Date(vDate); d.setDate(d.getDate() + n); 
      vDate = d.toISOString().split('T')[0]; render(); 
    }
    
    function setSubView(sub) { viewSub = sub; selectedJams = []; selectedDays = []; render(); }
    
    function setKampus(k) { 
      viewKampus = k; 
      const logo = document.getElementById('nav-logo');
      if(k === 'PUTRI') {
        logo.className = 'bg-gradient-to-br from-fuchsia-600 to-pink-700 p-2 rounded-xl text-white shadow-lg';
      } else {
        logo.className = 'bg-gradient-to-br from-blue-600 to-indigo-700 p-2 rounded-xl text-white shadow-lg';
      }
      render(); 
    }

    function getMergedDB(targetDate, targetKampus) {
      const d = new Date(targetDate + "T00:00:00"); 
      let day = d.getDay(); if (day === 0) day = 7;
      
      let activeDB = targetKampus === 'PUTRI' ? [...(state.db_putri || [])] : [...(state.db || [])];
      let res = activeDB.filter(x => x.tanggal === targetDate);
      
      (state.jadwal_tetap || []).forEach(jt => {
        if (jt.hari.toString() === day.toString() && jt.kampus === targetKampus) {
          res.push({ lab: jt.lab, jam_ke: jt.jam_ke, tanggal: targetDate, guru: jt.guru, kelas: jt.kelas, mapel: jt.mapel, keterangan: "JADWAL TETAP / KBM", nama_peminjam: "Sistem", kampus: jt.kampus });
        }
      });
      return res;
    }

    window.onload = function() {
      if (state.success) {
        const saved = localStorage.getItem('_xf_auth_2026_xyz');
        if (saved) { user = JSON.parse(saved); updateUI(); }
        const defaultRooms = getM('LAB');
        if (defaultRooms.length > 0) currentPlotingRuang = defaultRooms[0].nilai;
        render(); hideLoader();
      } else { 
        hideLoader(); alert("Sistem Mencegah Crash: " + state.message); 
      }
    };

    function refreshData() {
      showLoader("Menyinkronkan Data...");
      google.script.run.withSuccessHandler(res => { state = res; render(); hideLoader(); }).getAppData();
    }

    function show(v) { view = v; selectedJams = []; selectedDays = []; render(); }
    function hideLoader() { document.getElementById('loader').style.display = 'none'; }
    function showLoader(t) { if(t) document.getElementById('loader-text').innerText = t; document.getElementById('loader').style.display = 'flex'; }
    
    function updateUI() {
      const a = document.getElementById('admin-nav'); const l = document.getElementById('nav-login');
      if (user) { a?.classList.remove('hidden'); l?.classList.add('hidden'); } 
      else { a?.classList.add('hidden'); l?.classList.remove('hidden'); }
    }

    function render() {
      const el = document.getElementById('root');
      ['dashboard', 'form', 'history', 'master', 'login', 'jadwal', 'rekap', 'broadcast', 'massal', 'ploting'].forEach(id => {
        document.getElementById('nav-' + id)?.classList.remove('nav-active');
      });
      document.getElementById('nav-' + view)?.classList.add('nav-active');
      
      const themeColor = viewKampus === 'PUTRA' ? 'bg-blue-600' : 'bg-fuchsia-600';
      const themeGradient = viewKampus === 'PUTRA' ? 'from-blue-600 to-indigo-700' : 'from-fuchsia-600 to-pink-600';

      if (view === 'dashboard') renderDashboard(el, themeColor, themeGradient);
      else if (view === 'form') renderForm(el, themeColor, themeGradient);
      else if (view === 'jadwal') renderJadwalTetap(el, themeGradient);
      else if (view === 'ploting') renderPloting(el, themeColor, themeGradient);
      else if (view === 'rekap') renderRekap(el, themeColor);
      else if (view === 'broadcast') renderBroadcast(el, themeColor, themeGradient);
      else if (view === 'massal') renderMassal(el, themeGradient);
      else if (view === 'history') renderHistory(el);
      else if (view === 'master') renderMaster(el);
      else if (view === 'login') renderLogin(el);
    }

    function toggleJam(v, btnEl) {
      const i = selectedJams.indexOf(v);
      if (i > -1) { selectedJams.splice(i, 1); btnEl.classList.remove('selected'); } 
      else { selectedJams.push(v); btnEl.classList.add('selected'); }
      document.getElementById('input_jam').value = selectedJams.join(',');
    }

    function toggleDay(v, btnEl) {
      const i = selectedDays.indexOf(v);
      if (i > -1) { selectedDays.splice(i, 1); btnEl.classList.remove('selected'); } 
      else { selectedDays.push(v); btnEl.classList.add('selected'); }
      document.getElementById('input_hari').value = selectedDays.join(',');
    }

    // ==========================================
    // 1. DASHBOARD
    // ==========================================
    function renderDashboard(el, tColor, tGrad) {
      const isLab = viewSub === 'lab';
      const cols = getM(isLab ? 'LAB' : 'RUANGAN');
      const rows = getM(isLab ? 'JAM' : 'WAKTU_RUANG');
      const dbView = getMergedDB(vDate, viewKampus);
      
      const bookingMap = {};
      dbView.forEach(b => { bookingMap[b.lab + '_' + b.jam_ke] = b; });
      
      let html = `
      <div class="space-y-6 fade-in">
        <div class="flex flex-col md:flex-row gap-3 justify-between items-center bg-white p-3 rounded-2xl shadow-sm border border-slate-200">
          <div class="flex gap-2 p-1.5 bg-slate-100 rounded-xl w-full md:w-auto">
             <button onclick="setKampus('PUTRA')" class="${viewKampus==='PUTRA'?'bg-white shadow-sm text-blue-700 font-black':'text-slate-500 hover:bg-slate-200'} px-6 py-2.5 rounded-lg text-xs uppercase transition-all flex-1">Kampus Putra</button>
             <button onclick="setKampus('PUTRI')" class="${viewKampus==='PUTRI'?'bg-white shadow-sm text-fuchsia-700 font-black':'text-slate-500 hover:bg-slate-200'} px-6 py-2.5 rounded-lg text-xs uppercase transition-all flex-1">Kampus Putri</button>
          </div>
          <div class="flex gap-2 p-1.5 bg-slate-100 rounded-xl w-full md:w-auto">
             <button onclick="setSubView('lab')" class="${isLab?'bg-slate-800 text-white shadow-sm':'text-slate-500 hover:bg-slate-200'} px-6 py-2.5 rounded-lg text-xs font-black uppercase transition-all flex-1">Jadwal Lab</button>
             <button onclick="setSubView('ruang')" class="${!isLab?'bg-slate-800 text-white shadow-sm':'text-slate-500 hover:bg-slate-200'} px-6 py-2.5 rounded-lg text-xs font-black uppercase transition-all flex-1">Jadwal Ruang</button>
          </div>
        </div>

        <div class="bg-gradient-to-r ${tGrad} rounded-3xl shadow-lg p-1.5 flex flex-col md:flex-row justify-between items-center text-white relative overflow-hidden">
          <div class="px-8 py-4 flex items-center gap-4 z-10">
            <h2 class="text-xl font-black uppercase tracking-wide">DASBOR ${isLab?'LABKOM':'RUANGAN'}</h2>
            <span class="bg-white/20 px-3 py-1 rounded-full text-[10px] font-black uppercase backdrop-blur-sm">${viewKampus}</span>
          </div>
          <div class="flex items-center pr-4 pb-4 md:pb-0 z-10 w-full md:w-auto px-4 md:px-0">
            <button onclick="shiftDate(-1)" class="w-12 h-12 bg-white/10 hover:bg-white/20 rounded-2xl font-black text-lg transition-colors flex items-center justify-center">&larr;</button>
            <div class="relative flex items-center justify-center bg-white/10 hover:bg-white/20 rounded-2xl px-6 h-12 min-w-[240px] transition-colors mx-2 group">
               <span class="text-[13px] font-black uppercase tracking-wider group-hover:scale-105 transition-transform">${formatTanggalIndo(vDate)}</span>
               <input type="date" value="${vDate}" onchange="vDate=this.value; render()" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-20" />
            </div>
            <button onclick="shiftDate(1)" class="w-12 h-12 bg-white/10 hover:bg-white/20 rounded-2xl font-black text-lg transition-colors flex items-center justify-center">&rarr;</button>
          </div>
          <svg class="absolute top-0 right-0 opacity-10" width="200" height="200" viewBox="0 0 200 200" fill="none"><circle cx="100" cy="100" r="100" fill="white"/></svg>
        </div>

        <div class="bg-white rounded-3xl shadow-[0_8px_30px_rgb(0,0,0,0.06)] border border-slate-100 overflow-hidden">
          <div class="overflow-x-auto custom-scrollbar p-3">
            <table class="w-full border-separate border-spacing-2 min-w-[900px]">
              <thead>
                <tr>
                  <th class="py-4 px-4 w-28 bg-slate-50 rounded-2xl text-slate-400 text-[10px] font-black uppercase">WAKTU</th>
                  ${cols.map(lb => {
                    const cId = getHashNum(lb.nilai);
                    return `<th class="py-4 px-4 bg-slate-50 rounded-2xl"><div class="flex items-center justify-center gap-2"><span class="w-2.5 h-2.5 rounded-full ${bgColors[cId]} shadow-sm"></span><span class="text-[12px] font-black uppercase text-slate-800">${isLab ? 'LAB ' : ''}${escapeHTML(lb.nilai)}</span></div></th>`;
                  }).join('')}
                </tr>
              </thead>
              <tbody>`;
                
      rows.forEach(jm => {
