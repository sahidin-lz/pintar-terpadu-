        if (selectedClass === "ALL" || kSiswa === selectedClass) {
          optsHTML += `<option value="${escapeHTML(nSiswa)}|${escapeHTML(kSiswa)}">${escapeHTML(nSiswa)} (${escapeHTML(kSiswa)})</option>`;
