      if (newVal === null || newVal.trim() === "" || newVal === current) return;
      showLoader("Menyimpan Template...");
      google.script.run.withSuccessHandler(res => { if(res.success) refreshData(); else { alert(res.message); hideLoader(); } }).updateSetting('BROADCAST_TEMPLATE', newVal);
    }

    function generateBroadcastText(targetDate, kampus, isLab) {
      const db = getMergedDB(targetDate, kampus);
      const cols = getM(isLab ? 'LAB' : 'RUANGAN');
      const rows = getM(isLab ? 'JAM' : 'WAKTU_RUANG');
      let dataText = "";

      if (cols.length === 0) {
        return `_Tidak ada data master lokasi._`;
      }

      cols.forEach(lb => {
        let groupedDB = [];
        let currentGroup = null;

        rows.forEach(jm => {
          if (!jm.nilai) return;

          const b = db.find(x => x.lab === lb.nilai && String(x.jam_ke) === String(jm.nilai));
          
          let key, detail;
          if (b) {
            key = `${b.mapel}-${b.guru}-${b.kelas}-${b.keterangan}`;
            detail = b;
          } else {
            key = "KOSONG";
            detail = null;
          }

          if (currentGroup === null) {
            currentGroup = { key: key, detail: detail, jams: [jm.nilai] };
          } else if (currentGroup.key === key) {
            currentGroup.jams.push(jm.nilai);
          } else {
            groupedDB.push(currentGroup);
            currentGroup = { key: key, detail: detail, jams: [jm.nilai] };
          }
        });
        
        if (currentGroup) groupedDB.push(currentGroup);

        let namaRuang = String(lb.nilai).toUpperCase();
        if (isLab && !namaRuang.includes('LAB')) {
            namaRuang = 'LABKOM ' + namaRuang;
        }

        let divider = "==========================================\n";
        dataText += divider;
        dataText += `${namaRuang} ${kampus}\n`;
        dataText += divider;

        groupedDB.forEach(d => {
          let jamStr = d.jams[0];
          
          if (d.jams.length > 1) {
            let validNums = d.jams.map(j => parseInt(String(j).trim(), 10)).filter(n => !isNaN(n));
            
            if (validNums.length === d.jams.length) {
              let sortedJams = validNums.sort((x, y) => x - y);
              let isConsecutive = true;
              for(let i = 1; i < sortedJams.length; i++) {
                if (sortedJams[i] !== sortedJams[i-1] + 1) {
                  isConsecutive = false; break;
                }
              }
              if (isConsecutive) jamStr = sortedJams[0] + " - " + sortedJams[sortedJams.length-1];
              else jamStr = sortedJams.join(', ');
            } else {
              jamStr = d.jams.join(', ');
            }
          }

          dataText += `▪️ *${namaRuang}* (${isLab ? 'Jam' : 'Waktu'} ${jamStr})\n`;
          
          if (d.key === "KOSONG") {
            dataText += `   _KOSONG_\n\n`;
          } else {
            dataText += `   Guru: ${d.detail.guru}\n`;
            dataText += `   Kelas: ${d.detail.kelas !== '-' ? d.detail.kelas : 'Tanpa Kelas'} | Mapel: ${d.detail.mapel}\n`;
            if (d.detail.keterangan && d.detail.keterangan !== "JADWAL TETAP / KBM") {
              dataText += `   Ket: ${d.detail.keterangan}\n`;
            }
            dataText += `\n`;
          }
        });
      });

      let template = getSetting('BROADCAST_TEMPLATE');
      if(!template) {
        template = "==========================================\n📢 *INFO JADWAL RUANGAN & LABKOM* 📢\n🏢 Area: *{{KAMPUS}}*\n🗓 Tanggal: *{{TANGGAL}}*\n{{DATA}}==========================================\nBooking Link:\n_s.id/bookingruangansma_\n==========================================";
      }
      
      return template
        .replace('{{KAMPUS}}', kampus)
        .replace('{{TANGGAL}}', formatTanggalIndo(targetDate))
        .replace('{{DATA}}', dataText);
    }

