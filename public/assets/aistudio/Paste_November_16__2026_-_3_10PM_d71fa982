function getFastData(sheet) {
  if (!sheet) return [];
  let lr = sheet.getLastRow();
  let lc = sheet.getLastColumn();
  if (lr < 1 || lc < 1) return [];
  return sheet.getRange(1, 1, lr, lc).getValues();
}
function getFastDateStr(d) {
  if (!d) return "";
  let dateObj = (d.constructor === Date) ? d : new Date(d);
  if (!isNaN(dateObj.getTime())) {
    let m = dateObj.getMonth() + 1, day = dateObj.getDate();
    return dateObj.getFullYear() + "-" + (m < 10 ? '0' + m : m) + "-" + (day < 10 ? '0' + day : day);
  }
  return String(d);
}
function getFastDateIndo(d) {
  if (!d) return "";
  let dateObj = (d.constructor === Date) ? d : new Date(d);
  if (!isNaN(dateObj.getTime())) {
    let m = dateObj.getMonth() + 1, day = dateObj.getDate();
    return (day < 10 ? '0' + day : day) + "/" + (m < 10 ? '0' + m : m) + "/" + dateObj.getFullYear();
  }
  return String(d);
}
function formatKelas(val) {
  if (val instanceof Date) {
    let d = val.getDate(), m = val.getMonth() + 1;
    return (d < 10 ? '0' + d : d) + "-" + (m < 10 ? '0' + m : m);
  }
  let strVal = String(val || "").trim();
  if (strVal.includes('T') && strVal.endsWith('Z')) {
    let t = new Date(strVal);
    if (!isNaN(t.getTime())) {
      let d = t.getDate(), m = t.getMonth() + 1;
      return (d < 10 ? '0' + d : d) + "-" + (m < 10 ? '0' + m : m);
    }
  }
  return strVal.toUpperCase();
}
function getRecentData(sheet, limit = 4000) {
  if (!sheet) return [];
  let lr = sheet.getLastRow();
  let lc = sheet.getLastColumn();
  if (lr < 1 || lc < 1) return [];
  if (lr <= limit) return sheet.getRange(1, 1, lr, lc).getValues();
  let header = sheet.getRange(1, 1, 1, lc).getValues();
  let body = sheet.getRange(lr - limit + 1, 1, limit, lc).getValues();
  return header.concat(body);
}
function getMasterDataCached(sheetName) {
  const cache = CacheService.getScriptCache();
  const cachedData = cache.get(sheetName);
  if (cachedData) { try { return JSON.parse(cachedData); } catch(e) { } }
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(sheetName);
  if (!sheet) return [];
  const data = getFastData(sheet);
  try { if (data.length < 5000) { cache.put(sheetName, JSON.stringify(data), 3600); } } catch(e) {}
  return data;
}
function clearCacheSystem() {
  const cache = CacheService.getScriptCache();
  cache.removeAll(["Master_Siswa_Putra", "Master_Siswa_Putri", "Jadwal_Putra", "Jadwal_Putri", "Master_Kamar_Putra", "Master_Kamar_Putri", "Master_Guru"]);
  return "Memori Cache Berhasil Dibersihkan! Sistem siap dengan data terbaru.";
}
function getListGuru(jenis, gender) {
  const data = getMasterDataCached("Master_Guru");
  let res = [];
  let targetJabatan = "Guru";
  if (jenis === "Asrama") targetJabatan = (gender === "Putra" ? "Musyrif" : "Musyrifah");
  else if (jenis === "Al-Quran") targetJabatan = "Qur'an";
  for(let i=1, len=data.length; i<len; i++) {
    if(data[i][1]) {
      let jabatan = String(data[i][2] || "").trim();
      if(jabatan === "" || jabatan.toLowerCase().includes(targetJabatan.toLowerCase()) || jenis === "Al-Quran" || jenis === "Semua") {
        res.push(String(data[i][1]).trim());
      }
    }
  }
  return res.sort((a, b) => a.localeCompare(b));
}
function getKamarMusyrif(namaGuru, gender) {
  let data = getMasterDataCached("Master_Kamar_" + gender);
  let reqGuru = String(namaGuru).trim().toLowerCase().replace(/["']/g, "").replace(/\s+/g, " ");
  let rooms = [];
  for(let i=1; i<data.length; i++) {
    let col0 = String(data[i][0]).trim();
    let col1 = String(data[i][1]).trim().toLowerCase().replace(/["']/g, "").replace(/\s+/g, " ");
    if (col1 && (col1.includes(reqGuru) || reqGuru.includes(col1))) { if (col0) rooms.push(col0); } 
    else if (col0 && (col0.includes(reqGuru) || reqGuru.includes(col0))) { if (String(data[i][1]).trim()) rooms.push(String(data[i][1]).trim()); }
  }
  return rooms.sort((a, b) => a.localeCompare(b));
}
function getJadwal(hari, namaGuru, gender) {
  const data = getMasterDataCached("Jadwal_" + gender);
  let hasil = [];
  let jadwalUnik = new Set();
  let reqHari = String(hari).trim().toLowerCase();
  let reqGuru = String(namaGuru).trim().toLowerCase().replace(/["']/g, "").replace(/\s+/g, " ");
  if (!reqGuru) return [];
  for (let i = 1, len = data.length; i < len; i++) {
    if (String(data[i][1]).trim().toLowerCase() !== reqHari) continue;
    let rowGuru = String(data[i][0]).trim().toLowerCase().replace(/["']/g, "").replace(/\s+/g, " ");
    if (rowGuru && (rowGuru.includes(reqGuru) || reqGuru.includes(rowGuru))) {
      let kls = formatKelas(data[i][2]);
      let mpl = String(data[i][3]).trim().toUpperCase();
      let gabungan = kls + "|" + mpl;
      if(!jadwalUnik.has(gabungan)) {
        jadwalUnik.add(gabungan);
        hasil.push({ kelas: kls, mapel: mpl, jamKe: String(data[i][4]).trim() });
      }
    }
  }
  hasil.sort((a, b) => a.kelas.localeCompare(b.kelas) || a.mapel.localeCompare(b.mapel));
  return hasil;
}
function getSiswaForm(tanggal, guru, targetGrup, mapelAtauKeperluan, jenisPresensi, gender) {
  const dataSiswa = getMasterDataCached("Master_Siswa_" + gender);
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sheetLogName = (jenisPresensi === "Al-Quran") ? ("Log_AlQuran_" + gender) : ("Log_" + jenisPresensi + "_" + gender);
  const sheetLog = ss.getSheetByName(sheetLogName);
  if (!sheetLog) return { error: "Sheet " + sheetLogName + " tidak ada!" };
  const dataAbsen = getRecentData(sheetLog, 4000);
  let dataAsramaPagi = [];
  
  if (jenisPresensi !== "Asrama") {
    let sheetAsrama = ss.getSheetByName("Log_Asrama_" + gender);
    if (sheetAsrama) dataAsramaPagi = getRecentData(sheetAsrama, 4000);
  }
  
  let reqMapel = String(mapelAtauKeperluan).trim();
  let reqGuru = String(guru).trim().toLowerCase().replace(/["']/g, "").replace(/\s+/g, " ");
  let reqGrupStr = String(targetGrup).trim();
  let targetGrupArray = reqGrupStr.split(",").map(item => item.trim().toUpperCase());
  
  let mapSiswa = new Map();
  let indexNamaSiswa = 1;
  let indexPencarian = 2; 
  if (jenisPresensi === "Asrama") indexPencarian = 3;
  else if (jenisPresensi === "Al-Quran") indexPencarian = 4;
  
  for (let i = 1, len = dataSiswa.length; i < len; i++) {
    let valSiswa = formatKelas(dataSiswa[i][indexPencarian]);
    let kelasAsliSiswa = formatKelas(dataSiswa[i][indexPencarian]);
    let isMatch = false;
    for(let t=0; t<targetGrupArray.length; t++) {
      let target = targetGrupArray[t];
      if (target !== "" && valSiswa !== "" && (valSiswa === target || valSiswa.includes(target) || target.includes(valSiswa))) { isMatch = true; break; }
    }
    if (isMatch) {
      let nama = String(dataSiswa[i][indexNamaSiswa]).trim();
      let defaultStatus = 'H', defaultKet = '';
      if (jenisPresensi !== "Asrama" && dataAsramaPagi.length > 0) {
        for (let a = 1; a < dataAsramaPagi.length; a++) {
          if (getFastDateStr(dataAsramaPagi[a][1]) === tanggal && String(dataAsramaPagi[a][5]).trim() === nama) {
            let statusAsrama = String(dataAsramaPagi[a][6]).toUpperCase();
            if (statusAsrama === 'S' || statusAsrama === 'I' || statusAsrama === 'A') { defaultStatus = statusAsrama; defaultKet = "Otomatis Asrama: " + String(dataAsramaPagi[a][7]); }
            break;
          }
        }
      }
      mapSiswa.set(nama, { nama: nama, status: defaultStatus, keterangan: defaultKet, tilawah: '', murajaah: '', setoran: '', kelasAsli: kelasAsliSiswa });
    }
  }
  
  let materi = "", isEdit = false;
  for (let i = dataAbsen.length - 1; i >= 1; i--) {
    if (getFastDateStr(dataAbsen[i][1]) !== tanggal) continue;
    let rowGuru = String(dataAbsen[i][2]).trim().toLowerCase().replace(/["']/g, "").replace(/\s+/g, " ");
    
    if (!rowGuru.includes(reqGuru) && !reqGuru.includes(rowGuru)) continue;
    
    if (jenisPresensi === "Al-Quran") {
      if (formatKelas(dataAbsen[i][3]) !== reqGrupStr) continue;
      isEdit = true;
      let s = mapSiswa.get(String(dataAbsen[i][4]).trim());
      if (s) { s.status = dataAbsen[i][5]; s.keterangan = dataAbsen[i][6]; s.tilawah = dataAbsen[i][7] || ''; s.murajaah = dataAbsen[i][8] || ''; s.setoran = dataAbsen[i][9] || ''; }
    } else {
      if (formatKelas(dataAbsen[i][4]) !== reqGrupStr) continue;
      if (String(dataAbsen[i][3]).trim() !== reqMapel) continue;
      isEdit = true;
      materi = String(dataAbsen[i][8] || '');
      let s = mapSiswa.get(String(dataAbsen[i][5]).trim());
      if (s) { s.status = dataAbsen[i][6]; s.keterangan = dataAbsen[i][7]; }
    }
  }
  let arrSiswaSorted = Array.from(mapSiswa.values()).sort((a, b) => a.nama.localeCompare(b.nama));
  return { siswa: arrSiswaSorted, materi: materi, isEdit: isEdit, grupAktif: reqGrupStr };
}
function simpanAbsen(dataAbsen) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let targetSheetName = (dataAbsen.jenisPresensi === "Al-Quran") ? ("Log_AlQuran_" + dataAbsen.gender) : ("Log_" + dataAbsen.jenisPresensi + "_" + dataAbsen.gender);
  const sheet = ss.getSheetByName(targetSheetName);
  if (!sheet) return "Gagal: Sheet " + targetSheetName + " tidak ada!";
  const timestamp = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "yyyy-MM-dd HH:mm:ss");
  
  let reqGuruRaw = String(dataAbsen.guru).trim();
  let reqGuru = reqGuruRaw.toLowerCase().replace(/["']/g, "").replace(/\s+/g, " ");
  
  let reqGrup = dataAbsen.kelas.trim();
  let reqGrupArray = reqGrup.split(",").map(x => x.trim().toUpperCase());
  let reqMapel = dataAbsen.mapel.trim();
  let reqTgl = dataAbsen.tanggal;
  let rowsToDelete = [];
  let lr = sheet.getLastRow();
  let lc = sheet.getLastColumn();
  
  if (lr > 1) {
     let limit = 4000;
     let startRow = (lr > limit) ? (lr - limit + 1) : 2;
     let numRows = lr - startRow + 1;
     let data = sheet.getRange(startRow, 1, numRows, lc).getValues();
     let offset = startRow - 1; 
     for (let i = data.length - 1; i >= 0; i--) {
        if (getFastDateStr(data[i][1]) !== reqTgl) continue;
        let rowGuru = String(data[i][2]).trim().toLowerCase().replace(/["']/g, "").replace(/\s+/g, " ");
        if (!rowGuru.includes(reqGuru) && !reqGuru.includes(rowGuru)) continue;
        if (dataAbsen.jenisPresensi === "Al-Quran") { 
            let rowGrp = formatKelas(data[i][3]);
            if (!reqGrupArray.includes(rowGrp) && rowGrp !== reqGrup.toUpperCase()) continue; 
        } else { 
            let rowGrp = formatKelas(data[i][4]);
            if (!reqGrupArray.includes(rowGrp) && rowGrp !== reqGrup.toUpperCase()) continue; 
            if (String(data[i][3]).trim() !== reqMapel) continue; 
        }
        rowsToDelete.push(i + 1 + offset);
     }
  }
  
  if (rowsToDelete.length > 0) {
    let currentStart = rowsToDelete[0], count = 1;
    for (let i = 1, len = rowsToDelete.length; i < len; i++) {
      if (rowsToDelete[i] === currentStart - 1) { currentStart = rowsToDelete[i]; count++; }
      else { sheet.deleteRows(currentStart, count); currentStart = rowsToDelete[i]; count = 1; }
    }
    sheet.deleteRows(currentStart, count);
  }
  
  let rowsToAppend = [];
  let siswaArr = dataAbsen.siswa;
  for(let i=0, len=siswaArr.length; i<len; i++) {
    let s = siswaArr[i];
    let finalGrup = (s.kelasAsli && s.kelasAsli !== "") ? s.kelasAsli : reqGrup; 
    if (dataAbsen.jenisPresensi === "Al-Quran") {
      rowsToAppend.push([ timestamp, reqTgl, reqGuruRaw.toUpperCase(), finalGrup, s.nama, s.status, s.keterangan, s.tilawah || '', s.murajaah || '', s.setoran || '' ]);
    } else {
      rowsToAppend.push([ timestamp, reqTgl, reqGuruRaw.toUpperCase(), reqMapel, finalGrup, s.nama, s.status, s.keterangan, dataAbsen.materi || '' ]);
    }
  }
  
  if(rowsToAppend.length > 0) {
     sheet.getRange(sheet.getLastRow() + 1, 1, rowsToAppend.length, rowsToAppend[0].length).setValues(rowsToAppend);
  }
  CacheService.getScriptCache().remove(targetSheetName);
  return rowsToDelete.length > 0 ? "Data Diperbarui!" : "Data Tersimpan!";
}
function simpanGuruAbsen(req) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sheet = ss.getSheetByName("Log_Guru_Absen");
  if (!sheet) return "ERROR: Sheet 'Log_Guru_Absen' tidak ditemukan. Harap buat terlebih dahulu!";
  const timestamp = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "yyyy-MM-dd HH:mm:ss");
  let lr = sheet.getLastRow();
  let lc = sheet.getLastColumn();
  let barisUpdate = -1;
  if (lr > 1) {
     let limit = 2000;
     let startRow = (lr > limit) ? (lr - limit + 1) : 2;
     let data = sheet.getRange(startRow, 1, lr - startRow + 1, lc).getValues();
     let offset = startRow - 1;
     for(let i=0; i<data.length; i++) {
        if(getFastDateStr(data[i][1]) === req.tanggal && String(data[i][2]).trim().toUpperCase() === String(req.namaGuru).trim().toUpperCase()) {
           barisUpdate = i + 1 + offset; break;
        }
     }
  }
  if(barisUpdate > -1) { 
      sheet.getRange(barisUpdate, 1, 1, 5).setValues([[timestamp, req.tanggal, req.namaGuru.toUpperCase(), req.status, req.keterangan]]); 
      CacheService.getScriptCache().remove("Log_Guru_Absen");
      return "Data Guru berhasil diperbarui!"; 
  } else { 
      sheet.appendRow([timestamp, req.tanggal, req.namaGuru.toUpperCase(), req.status, req.keterangan]); 
      CacheService.getScriptCache().remove("Log_Guru_Absen");
      return "Data Guru Tidak Hadir Berhasil Disimpan!"; 
  }
}
