function getGuruKosong(tanggal, jamStr, filterGender, filterJenjang) {
  let dateObj = new Date(tanggal);
  let hari = ["MINGGU", "SENIN", "SELASA", "RABU", "KAMIS", "JUMAT", "SABTU"][dateObj.getDay()];
  let jp = getMasterDataCached("Jadwal_Putra");
  let jpi = getMasterDataCached("Jadwal_Putri");
  let dataJadwalAll = [];
  if(jp.length > 1) { let d = jp.slice(1); d.forEach(r => { r.push("PUTRA"); dataJadwalAll.push(r); }); }
  if(jpi.length > 1) { let d = jpi.slice(1); d.forEach(r => { r.push("PUTRI"); dataJadwalAll.push(r); }); }
  
  let guruMengajar = new Set();
  let targetJams = jamStr.split(",").map(x => parseInt(x.trim()));
  let teacherProfile = {};
  
  for(let i=0; i<dataJadwalAll.length; i++) {
      let r = dataJadwalAll[i];
      let g = String(r[0]).trim().toUpperCase();
      let hariJadwal = String(r[1]).trim().toUpperCase();
      let kls = formatKelas(r[2]);
      let jam = String(r[4]).trim();
      let genderJadwal = r[r.length-1];
      if(!teacherProfile[g]) teacherProfile[g] = { genders: new Set(), jenjangs: new Set() };
      teacherProfile[g].genders.add(genderJadwal);
      if(kls.includes("10") || kls.includes("X") || kls.includes("T-01") || kls.includes("T-02")) teacherProfile[g].jenjangs.add("10");
      else if(kls.includes("11") || kls.includes("XI") || kls.includes("T-03") || kls.includes("T-04")) teacherProfile[g].jenjangs.add("11");
      else teacherProfile[g].jenjangs.add("12");
      if(hariJadwal === hari) {
          let parts = jam.split("-");
          let start = parseInt(parts[0]);
          let end = parts.length > 1 ? parseInt(parts[1]) : start;
          for(let t=0; t<targetJams.length; t++) {
              if(targetJams[t] >= start && targetJams[t] <= end) { guruMengajar.add(g); break; }
          }
      }
  }
  
  let guruAbsen = new Set();
  let dga = getMasterDataCached("Log_Guru_Absen");
  let tglStr = getFastDateStr(dateObj);
  for(let i=1; i<dga.length; i++) {
      if(getFastDateStr(dga[i][1]) === tglStr) { guruAbsen.add(String(dga[i][2]).trim().toUpperCase()); }
  }
  
  let guruKosong = [];
  let masterGuru = getMasterDataCached("Master_Guru");
  for(let i=1; i<masterGuru.length; i++) {
      let g = String(masterGuru[i][1]).trim().toUpperCase();
      let jabatan = String(masterGuru[i][2] || "").trim().toUpperCase();
      if(g && !guruMengajar.has(g) && !guruAbsen.has(g) && (jabatan === '' || jabatan.includes('GURU') || jabatan.includes('QUR'))) {
          let prof = teacherProfile[g] || { genders: new Set(), jenjangs: new Set() };
          let matchGender = true;
          if(filterGender !== "SEMUA") { matchGender = prof.genders.has(filterGender); }
          let matchJenjang = true;
          if(filterJenjang !== "SEMUA") { matchJenjang = prof.jenjangs.has(filterJenjang); }
          if(matchGender && matchJenjang) { guruKosong.push(g); }
      }
  }
  return guruKosong.sort();
}
function getBroadcastHarian(tanggal, gender) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sheetAsrama = ss.getSheetByName("Log_Asrama_" + gender);
  let tglIndo = getFastDateIndo(new Date(tanggal));
  let result = `📢 *INFORMASI HARIAN SEKOLAH (${gender.toUpperCase()})*\n📅 Tanggal: ${tglIndo}\n\n`;
  result += `*🛏️ INFO KEHADIRAN (BERDASARKAN KELAS AKADEMIK):*\n`;
  
  let asramaCount = 0;
  let mapKelas = new Map();
  let dataSiswa = getMasterDataCached("Master_Siswa_" + gender);
  if(dataSiswa.length > 0) {
    for(let i = 1; i < dataSiswa.length; i++) {
       let nama = String(dataSiswa[i][1]).trim();
       let kls = formatKelas(dataSiswa[i][2]);
       if(kls === "") kls = "TANPA KELAS";
       mapKelas.set(nama, kls);
    }
  }
  
  if (sheetAsrama) {
    let dAsrama = getRecentData(sheetAsrama, 4000);
    let listAbsenSiswa = [];
    for(let i=1; i<dAsrama.length; i++) {
      if(getFastDateStr(dAsrama[i][1]) === tanggal) {
        let status = String(dAsrama[i][6]).trim().toUpperCase();
        if(status === 'S' || status === 'I' || status === 'A') {
          let namaSiswa = String(dAsrama[i][5]).trim();
          let kelasAkademik = mapKelas.get(namaSiswa) || "TANPA KELAS";
          listAbsenSiswa.push({ nama: namaSiswa, kamar: String(dAsrama[i][4]).trim(), kelas: kelasAkademik, status: status, ket: String(dAsrama[i][7]).trim() });
        }
      }
    }
    listAbsenSiswa.sort((a,b) => a.kelas.localeCompare(b.kelas) || a.nama.localeCompare(b.nama));
    let kelasSaatIni = "";
    listAbsenSiswa.forEach(s => {
       if(s.kelas !== kelasSaatIni) { result += `\n🏷️ *KELAS ${s.kelas}*\n`; kelasSaatIni = s.kelas; }
       let emoji = s.status === 'S' ? '🤒' : (s.status === 'I' ? 'ℹ️' : '❌');
       result += `${emoji} ${s.nama} (${s.kelas})\n   Status: *${s.status}* - [Kamar: ${s.kamar}] ${s.ket}\n`;
       asramaCount++;
    });
  }
  
  if(asramaCount === 0) result += `- ✅ Seluruh santri/wati dilaporkan HADIR.\n`;
  result += `\n_Terima kasih atas perhatian Bapak/Ibu Wali Murid. Semoga proses belajar mengajar hari ini berjalan lancar dan penuh berkah._`;
  return result;
}
function getDashboardStats() {
  let sheets = ['Log_Belajar_Putra', 'Log_Belajar_Putri', 'Log_Asrama_Putra', 'Log_Asrama_Putri', 'Log_AlQuran_Putra', 'Log_AlQuran_Putri'];
  let stats = { hari: {H:0, T:0, S:0, I:0, A:0}, bulan: {H:0, T:0, S:0, I:0, A:0}, semester: {H:0, T:0, S:0, I:0, A:0} };
  let today = new Date(), currMonth = today.getMonth() + 1, currYear = today.getFullYear(), currDate = today.getDate();
  let isGanjil = (currMonth >= 7);
  
  sheets.forEach(sh => {
     let data = getMasterDataCached(sh);
     for(let i = data.length-1; i >= 1; i--) {
        let rawDate = data[i][1];
        if(!rawDate) continue;
        let rowDate = (rawDate.constructor === Date) ? rawDate : new Date(rawDate);
        if(isNaN(rowDate.getTime())) continue;
