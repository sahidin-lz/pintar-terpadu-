function doPost(e) {
  let response = { result: null, error: null };
  try {
    let body = JSON.parse(e.postData.contents);
    let fnName = body.functionName;
    let args = body.args || [];
    
    if (typeof this[fnName] === 'function') {
      response.result = this[fnName].apply(this, args);
    } else {
      response.error = "Fungsi " + fnName + " tidak ditemukan di sistem.";
    }
  } catch(err) {
    response.error = err.toString();
  }
  
  return ContentService.createTextOutput(JSON.stringify(response))
    .setMimeType(ContentService.MimeType.JSON);
}