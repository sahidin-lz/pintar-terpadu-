                rowsToDelete.push(i + 2);
            }
        }
     }
  }
  
  if (rowsToDelete.length > 0) {
    let currentStart = rowsToDelete[0], count = 1;
    for (let i = 1; i < rowsToDelete.length; i++) {
      if (rowsToDelete[i] === currentStart - 1) { currentStart = rowsToDelete[i]; count++; }
      else { sheet.deleteRows(currentStart, count); currentStart = rowsToDelete[i]; count = 1; }
    }
    sheet.deleteRows(currentStart, count);
  }
  
  let rowsToAppend = [];
  for(let i=0; i<req.siswa.length; i++) {
    let s = req.siswa[i];
    let klsFinal = (s.kelasAsli && s.kelasAsli !== "") ? s.kelasAsli : reqKelas.toUpperCase();
    rowsToAppend.push([ timestamp, reqTgl, reqJenis.toUpperCase(), reqRuang.toUpperCase(), reqP1.toUpperCase(), reqP2.toUpperCase(), klsFinal, reqMapel.toUpperCase(), s.nama, s.status, s.keterangan ]);
  }
  
  if(rowsToAppend.length > 0) {
     sheet.getRange(sheet.getLastRow() + 1, 1, rowsToAppend.length, rowsToAppend[0].length).setValues(rowsToAppend);
  }
  return rowsToDelete.length > 0 ? "Data Ujian Diperbarui!" : "Data Ujian Tersimpan!";
}
