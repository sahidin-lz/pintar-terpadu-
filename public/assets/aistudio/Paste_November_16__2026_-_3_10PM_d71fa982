  let reqTgl = req.tanggal, reqJenis = req.jenisUjian, reqRuang = req.ruangan, reqP1 = req.pengawas1, reqP2 = req.pengawas2, reqKelas = req.kelas, reqMapel = req.mapel;
  
  let rowsToDelete = [];
  let lr = sheet.getLastRow(), lc = sheet.getLastColumn();
  if (lr > 1) {
     let data = sheet.getRange(2, 1, lr - 1, lc).getValues();
     for (let i = data.length - 1; i >= 0; i--) {
        if (getFastDateStr(data[i][1]) === reqTgl && String(data[i][7]).trim().toUpperCase() === reqMapel.toUpperCase()) {
