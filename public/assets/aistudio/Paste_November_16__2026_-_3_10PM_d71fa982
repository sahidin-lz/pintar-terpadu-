function onEdit(e) {
  if (!e || !e.range) return;
  let sheetName = e.range.getSheet().getName();
  let triggerSheets = ["Jadwal_Putra", "Jadwal_Putri", "Master_Guru", "Master_Kamar_Putra", "Master_Kamar_Putri"];
  if (triggerSheets.includes(sheetName)) {
    clearCacheSystem();
  }
