function getSiswaByGroup(groupName, divisi) {
  let res = [];
  let sheets = ['Master_Siswa_Putra', 'Master_Siswa_Putri'];
  let reqGrp = String(groupName).trim().toUpperCase();
  
  if (divisi === 'Asrama') {
     let kamarList = new Set();
     kamarList.add(reqGrp);
     ['Master_Kamar_Putra', 'Master_Kamar_Putri'].forEach(sh => {
        let d = getMasterDataCached(sh);
        for(let i=1; i<d.length; i++) {
           if(String(d[i][1]).trim().toUpperCase() === reqGrp) { kamarList.add(String(d[i][0]).trim().toUpperCase()); }
        }
     });
     sheets.forEach(sh => {
        let d = getMasterDataCached(sh);
        for(let i=1; i<d.length; i++) {
           let kamarSiswa = String(d[i][3]).trim().toUpperCase();
           let match = false;
           kamarList.forEach(k => { if (kamarSiswa === k || kamarSiswa.includes(k) || k.includes(kamarSiswa)) match = true; });
           if (match) res.push(String(d[i][1]).trim());
        }
     });
  } else {
     let idxSearch = (divisi === 'Al-Quran') ? 4 : 2; 
     sheets.forEach(sh => {
        let d = getMasterDataCached(sh);
        for(let i=1; i<d.length; i++) {
           let val = formatKelas(d[i][idxSearch]);
           if(val === reqGrp || val.includes(reqGrp)) { res.push(String(d[i][1]).trim()); }
        }
     });
  }
  return res.sort((a,b) => a.localeCompare(b));
}
